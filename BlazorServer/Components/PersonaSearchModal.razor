@using DTOs
@using APIClients

@if (showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                        <i class="fas fa-search"></i> Buscar Persona
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="Close"></button>
                </div>
                <div class="modal-body">
                    <!-- Barra de búsqueda -->
                    <div class="row mb-3">
                        <div class="col-md-8">
                            <input type="text"
                                   class="form-control"
                                   placeholder="Buscar por nombre, apellido, legajo o email..."
                                   @bind="searchText"
                                   @bind:event="oninput"
                                   @onkeyup="HandleSearchKeyUp" />
                        </div>
                        <div class="col-md-2">
                            <button class="btn btn-primary w-100" @onclick="SearchPersonas" disabled="@loading">
                                @if (loading)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                <i class="fas fa-search"></i> Buscar
                            </button>
                        </div>
                        <div class="col-md-2">
                            <button class="btn btn-outline-secondary w-100" @onclick="ClearSearch">
                                <i class="fas fa-eraser"></i> Limpiar
                            </button>
                        </div>
                    </div>

                    <!-- Resultados -->
                    @if (loading)
                    {
                        <div class="text-center py-4">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Buscando personas...</span>
                            </div>
                            <p class="mt-2 text-muted">Buscando personas...</p>
                        </div>
                    }
                    else if (personas != null && personas.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Legajo</th>
                                        <th>Apellido</th>
                                        <th>Nombre</th>
                                        <th>Email</th>
                                        <th>Tipo</th>
                                        <th>Plan</th>
                                        <th class="text-end">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var persona in personas)
                                    {
                                        <tr>
                                            <td>@persona.Legajo</td>
                                            <td>@persona.Apellido</td>
                                            <td>@persona.Nombre</td>
                                            <td>@persona.Email</td>
                                            <td>
                                                <span class="badge @GetTipoPersonaBadgeClass(persona.TipoPersona)">
                                                    @GetTipoPersonaDisplayName(persona.TipoPersona)
                                                </span>
                                            </td>
                                            <td>@(persona.DescripcionPlan ?? "-")</td>
                                            <td class="text-end">
                                                <button class="btn btn-success btn-sm"
                                                        @onclick="() => SelectPersona(persona)"
                                                        title="Seleccionar esta persona">
                                                    <i class="fas fa-check"></i> Elegir
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else if (personas != null && !personas.Any())
                    {
                        <div class="alert alert-info text-center">
                            <i class="fas fa-info-circle"></i>
                            @(string.IsNullOrEmpty(searchText)
                                                ? "No hay personas disponibles"
                                                : "No se encontraron personas que coincidan con la búsqueda")
                </div>
                                }

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger">
                            <i class="fas fa-exclamation-triangle"></i> @errorMessage
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="Close">
                        <i class="fas fa-times"></i> Cancelar
                    </button>
                    <small class="text-muted me-auto">
                        @if (personas != null)
                        {
                            <text>@personas.Count() persona(s) encontrada(s)</text>
                        }
                    </small>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public EventCallback<PersonaDTO> OnPersonaSelected { get; set; }

    private bool showModal = false;
    private List<PersonaDTO>? personas;
    private string searchText = string.Empty;
    private bool loading = false;
    private string errorMessage = string.Empty;

    public async Task ShowModal()
    {
        showModal = true;
        searchText = string.Empty;
        errorMessage = string.Empty;
        personas = null;
        StateHasChanged();

        // Cargar todas las personas al abrir el modal
        await LoadPersonas();
    }

    private async Task LoadPersonas()
    {
        try
        {
            loading = true;
            errorMessage = string.Empty;

            if (string.IsNullOrWhiteSpace(searchText))
            {
                personas = (await PersonaAPIClient.GetAllAsync())?.ToList();
            }
            else
            {
                personas = (await PersonaAPIClient.GetByCriteriaAsync(searchText))?.ToList();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar personas: {ex.Message}";
            personas = new List<PersonaDTO>();
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    private async Task SearchPersonas()
    {
        await LoadPersonas();
    }

    private async Task ClearSearch()
    {
        searchText = string.Empty;
        await LoadPersonas();
    }

    private async Task HandleSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchPersonas();
        }
    }

    private async Task SelectPersona(PersonaDTO persona)
    {
        await OnPersonaSelected.InvokeAsync(persona);
        Close();
    }

    private void Close()
    {
        showModal = false;
        StateHasChanged();
    }

    private string GetTipoPersonaDisplayName(int tipoPersona)
    {
        return tipoPersona switch
        {
            1 => "Alumno",
            2 => "Docente",
            3 => "Administrativo",
            _ => "Desconocido"
        };
    }

    private string GetTipoPersonaBadgeClass(int tipoPersona)
    {
        return tipoPersona switch
        {
            1 => "bg-success",
            2 => "bg-primary",
            3 => "bg-warning",
            _ => "bg-secondary"
        };
    }
}