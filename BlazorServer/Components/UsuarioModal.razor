@using DTOs
@using APIClients
@inject IJSRuntime JSRuntime

@if (showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        @if (mode == FormMode.Add)
                        {
                            <text><i class="fas fa-user-plus"></i> Agregar Usuario</text>
                        }
                        else
                        {
                            <text><i class="fas fa-user-edit"></i> Modificar Usuario</text>
                        }
                    </h5>
                    <button type="button" class="btn-close" @onclick="Close"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="currentUsuario" OnValidSubmit="HandleValidSubmit" Context="formContext">
                        <DataAnnotationsValidator />

                        @if (mode == FormMode.Update)
                        {
                            <div class="mb-3">
                                <label class="form-label">ID</label>
                                <input type="text" class="form-control" value="@currentUsuario.Id" readonly />
                            </div>
                        }

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label">Nombre de Usuario *</label>
                                    <InputText @bind-Value="currentUsuario.NombreUsuario"
                                               class="form-control"
                                               @onblur="ValidateNombreUsuario" />
                                    @if (validationErrors.ContainsKey("NombreUsuario"))
                                    {
                                        <div class="text-danger small">@validationErrors["NombreUsuario"]</div>
                                    }
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label">
                                        Contraseña @(mode == FormMode.Add ? "*" : "(dejar vacío para mantener)")
                                    </label>
                                    <InputText @bind-Value="currentUsuario.Clave"
                                               type="password"
                                               class="form-control"
                                               placeholder="@(mode == FormMode.Add ? "Mínimo 6 caracteres" : "Solo si desea cambiarla")" />
                                    @if (validationErrors.ContainsKey("Clave"))
                                    {
                                        <div class="text-danger small">@validationErrors["Clave"]</div>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label">Rol *</label>
                                    <InputSelect @bind-Value="currentUsuario.Rol" class="form-select">
                                        <option value="0">Seleccionar Rol</option>
                                        <option value="1">Administrador</option>
                                        <option value="2">Docente</option>
                                        <option value="3">Alumno</option>
                                    </InputSelect>
                                    @if (validationErrors.ContainsKey("Rol"))
                                    {
                                        <div class="text-danger small">@validationErrors["Rol"]</div>
                                    }
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label">ID Persona</label>
                                    <InputNumber @bind-Value="currentUsuario.IdPersona" class="form-control" />
                                    <small class="form-text text-muted">Opcional - Vincular con una persona existente</small>
                                    @if (validationErrors.ContainsKey("IdPersona"))
                                    {
                                        <div class="text-danger small">@validationErrors["IdPersona"]</div>
                                    }
                                </div>
                            </div>
                        </div>

                        @if (mode == FormMode.Update)
                        {
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label">Estado</label>
                                        <div class="form-check form-switch">
                                            <InputCheckbox @bind-Value="currentUsuario.Habilitado"
                                                           class="form-check-input"
                                                           id="habilitadoSwitch" />
                                            <label class="form-check-label" for="habilitadoSwitch">
                                                @(currentUsuario.Habilitado ? "Activo" : "Inactivo")
                                            </label>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label">Fecha de Alta</label>
                                        <input type="text" class="form-control" value="@currentUsuario.FechaAlta.ToString("dd/MM/yyyy HH:mm")" readonly />
                                    </div>
                                </div>
                            </div>
                        }

                        @if (currentUsuario.IdPersona.HasValue && currentUsuario.IdPersona > 0)
                        {
                            <div class="alert alert-info">
                                <strong>Información de la Persona:</strong>
                                <ul class="mb-0 mt-2">
                                    @if (!string.IsNullOrEmpty(currentUsuario.NombreCompletoPersona))
                                    {
                                        <li>Nombre: @currentUsuario.NombreCompletoPersona</li>
                                    }
                                    @if (currentUsuario.Legajo.HasValue)
                                    {
                                        <li>Legajo: @currentUsuario.Legajo</li>
                                    }
                                </ul>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger">
                                <i class="fas fa-exclamation-triangle"></i> @errorMessage
                            </div>
                        }

                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="Close">
                                <i class="fas fa-times"></i> Cancelar
                            </button>
                            <button type="submit" class="btn btn-primary" disabled="@saving">
                                @if (saving)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                <i class="fas fa-save"></i> @(mode == FormMode.Add ? "Agregar" : "Modificar")
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public EventCallback OnUsuarioChanged { get; set; }

    private bool showModal = false;
    private FormMode mode = FormMode.Add;
    private UsuarioDTO currentUsuario = new UsuarioDTO();
    private bool saving = false;
    private string errorMessage = string.Empty;
    private Dictionary<string, string> validationErrors = new Dictionary<string, string>();

    public enum FormMode
    {
        Add,
        Update
    }

    public async Task ShowAddModal()
    {
        mode = FormMode.Add;
        currentUsuario = new UsuarioDTO
        {
            Habilitado = true,
            FechaAlta = DateTime.Now
        };
        ClearValidationErrors();
        showModal = true;
        StateHasChanged();
    }

    public async Task ShowEditModal(UsuarioDTO usuario)
    {
        mode = FormMode.Update;
        currentUsuario = new UsuarioDTO
        {
            Id = usuario.Id,
            NombreUsuario = usuario.NombreUsuario,
            Clave = string.Empty, // No mostrar la contraseña hasheada
            Habilitado = usuario.Habilitado,
            FechaAlta = usuario.FechaAlta,
            Rol = usuario.Rol,
            IdPersona = usuario.IdPersona,
            Legajo = usuario.Legajo,
            NombrePersona = usuario.NombrePersona,
            ApellidoPersona = usuario.ApellidoPersona
        };
        ClearValidationErrors();
        showModal = true;
        StateHasChanged();
    }

    private async Task HandleValidSubmit()
    {
        if (!await ValidateUsuario())
            return;

        try
        {
            saving = true;
            errorMessage = string.Empty;

            if (mode == FormMode.Add)
            {
                await UsuarioAPIClient.AddAsync(currentUsuario);
            }
            else
            {
                await UsuarioAPIClient.UpdateAsync(currentUsuario);
            }

            await OnUsuarioChanged.InvokeAsync();
            Close();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            saving = false;
        }
    }

    private async Task<bool> ValidateUsuario()
    {
        ClearValidationErrors();
        bool isValid = true;

        // Validar Nombre de Usuario
        if (string.IsNullOrWhiteSpace(currentUsuario.NombreUsuario))
        {
            validationErrors["NombreUsuario"] = "El nombre de usuario es requerido";
            isValid = false;
        }
        else if (currentUsuario.NombreUsuario.Length < 3)
        {
            validationErrors["NombreUsuario"] = "El nombre de usuario debe tener al menos 3 caracteres";
            isValid = false;
        }

        // Validar Contraseña (solo en modo Add o si se proporciona en Update)
        if (mode == FormMode.Add)
        {
            if (string.IsNullOrWhiteSpace(currentUsuario.Clave))
            {
                validationErrors["Clave"] = "La contraseña es requerida";
                isValid = false;
            }
            else if (currentUsuario.Clave.Length < 6)
            {
                validationErrors["Clave"] = "La contraseña debe tener al menos 6 caracteres";
                isValid = false;
            }
        }
        else if (!string.IsNullOrWhiteSpace(currentUsuario.Clave) && currentUsuario.Clave.Length < 6)
        {
            validationErrors["Clave"] = "La contraseña debe tener al menos 6 caracteres";
            isValid = false;
        }

        // Validar Rol
        if (currentUsuario.Rol < 1 || currentUsuario.Rol > 3)
        {
            validationErrors["Rol"] = "Debe seleccionar un rol válido";
            isValid = false;
        }

        StateHasChanged();
        return isValid;
    }

    private async Task ValidateNombreUsuario()
    {
        if (!string.IsNullOrWhiteSpace(currentUsuario.NombreUsuario))
        {
            try
            {
                int? excludeId = mode == FormMode.Update ? currentUsuario.Id : null;
                bool exists = await UsuarioAPIClient.ExistsNombreUsuarioAsync(currentUsuario.NombreUsuario, excludeId);

                if (exists)
                {
                    validationErrors["NombreUsuario"] = "Este nombre de usuario ya está en uso";
                }
                else
                {
                    validationErrors.Remove("NombreUsuario");
                }
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error al validar nombre de usuario: {ex.Message}");
            }
        }
    }

    private void ClearValidationErrors()
    {
        validationErrors.Clear();
        errorMessage = string.Empty;
    }

    private void Close()
    {
        showModal = false;
        ClearValidationErrors();
        StateHasChanged();
    }
}
