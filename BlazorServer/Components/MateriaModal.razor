@using DTOs
@using APIClients
@inject IJSRuntime JSRuntime

@if (showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header gradient-bg text-white">
                    <h5 class="modal-title">
                        @if (mode == FormMode.Add)
                        {
                            <text>Agregar Materia</text>
                        }
                        else
                        {
                            <text>@(IsReadOnly ? "Ver Materia" : "Modificar Materia")</text>
                        }
                    </h5>
                    <button type="button" class="btn-close" @onclick="Close"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="currentMateria" OnValidSubmit="HandleValidSubmit">
                        <DataAnnotationsValidator />

                        @if (mode == FormMode.Update)
                        {
                            <div class="mb-3">
                                <label class="form-label">Id</label>
                                <input type="text" class="form-control" value="@currentMateria.IdMateria" readonly />
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label">Descripción *</label>
                            <InputText @bind-Value="currentMateria.DescripcionMateria"
                                       class="form-control"
                                       disabled="@IsReadOnly" />
                            @if (validationErrors.ContainsKey("DescripcionMateria"))
                            {
                                <div class="text-danger small">@validationErrors["DescripcionMateria"]</div>
                            }
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Horas Semanales *</label>
                            <InputNumber @bind-Value="currentMateria.HorasSemanales"
                                         class="form-control"
                                         disabled="@IsReadOnly" />
                            @if (validationErrors.ContainsKey("HorasSemanales"))
                            {
                                <div class="text-danger small">@validationErrors["HorasSemanales"]</div>
                            }
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Horas Totales *</label>
                            <InputNumber @bind-Value="currentMateria.HorasTotales"
                                         class="form-control"
                                         disabled="@IsReadOnly" />
                            @if (validationErrors.ContainsKey("HorasTotales"))
                            {
                                <div class="text-danger small">@validationErrors["HorasTotales"]</div>
                            }
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Plan *</label>
                            <InputSelect @bind-Value="currentMateria.IdPlan"
                                         class="form-select"
                                         disabled="@IsReadOnly">
                                <option value="0">Seleccionar Plan</option>
                                @if (planes != null)
                                {
                                    @foreach (var plan in planes)
                                    {
                                        <option value="@plan.IdPlan">@plan.Descripcion - @plan.DescripcionEspecialidad</option>
                                    }
                                }
                            </InputSelect>
                            @if (validationErrors.ContainsKey("Plan"))
                            {
                                <div class="text-danger small">@validationErrors["Plan"]</div>
                            }
                        </div>

                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger">
                                @errorMessage
                            </div>
                        }

                        @if (IsReadOnly)
                        {
                            <div class="alert alert-info">
                                <i class="fas fa-info-circle"></i> No tienes permisos para modificar esta información.
                            </div>
                        }

                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-danger" @onclick="Close">
                                @(IsReadOnly ? "Cerrar" : "Cancelar")
                            </button>
                            @if (!IsReadOnly)
                            {
                                <button type="submit" class="btn btn-outline-primary" disabled="@saving">
                                    @if (saving)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2"></span>
                                    }
                                    @(mode == FormMode.Add ? "Agregar" : "Modificar")
                                </button>
                            }
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .gradient-bg {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
        border-bottom: none;
    }
</style>

@code {
    [Parameter] public EventCallback OnMateriaChanged { get; set; }
    [Parameter] public bool IsReadOnly { get; set; } = false;

    private bool showModal = false;
    private FormMode mode = FormMode.Add;
    private MateriaDTO currentMateria = new MateriaDTO();
    private bool saving = false;
    private string errorMessage = string.Empty;
    private Dictionary<string, string> validationErrors = new Dictionary<string, string>();
    private List<PlanDTO>? planes;

    public enum FormMode
    {
        Add,
        Update
    }

    public async Task ShowAddModal()
    {
        if (IsReadOnly)
        {
            errorMessage = "No tienes permisos para agregar materias.";
            return;
        }

        mode = FormMode.Add;
        currentMateria = new MateriaDTO();
        await LoadPlanes();
        ClearValidationErrors();
        showModal = true;
        StateHasChanged();
    }

    public async Task ShowEditModal(MateriaDTO materia)
    {
        mode = FormMode.Update;
        currentMateria = new MateriaDTO
        {
            IdMateria = materia.IdMateria,
            DescripcionMateria = materia.DescripcionMateria,
            HorasSemanales = materia.HorasSemanales,
            HorasTotales = materia.HorasTotales,
            IdPlan = materia.IdPlan,
            DescripcionPlan = materia.DescripcionPlan,
            DescripcionEspecialidad = materia.DescripcionEspecialidad
        };
        await LoadPlanes();
        ClearValidationErrors();
        showModal = true;
        StateHasChanged();
    }

    private async Task HandleValidSubmit()
    {
        if (IsReadOnly)
        {
            errorMessage = "No tienes permisos para realizar esta acción.";
            return;
        }

        if (!await ValidateMateria())
            return;

        try
        {
            saving = true;
            errorMessage = string.Empty;

            if (mode == FormMode.Add)
            {
                await MateriaAPIClient.AddAsync(currentMateria);
            }
            else
            {
                await MateriaAPIClient.UpdateAsync(currentMateria);
            }

            await OnMateriaChanged.InvokeAsync();
            Close();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            saving = false;
        }
    }

    private async Task<bool> ValidateMateria()
    {
        ClearValidationErrors();
        bool isValid = true;

        if (string.IsNullOrWhiteSpace(currentMateria.DescripcionMateria))
        {
            validationErrors["DescripcionMateria"] = "La descripción es requerida";
            isValid = false;
        }

        if (currentMateria.HorasSemanales <= 0)
        {
            validationErrors["HorasSemanales"] = "Las horas semanales deben ser mayor a 0";
            isValid = false;
        }

        if (currentMateria.HorasTotales <= 0)
        {
            validationErrors["HorasTotales"] = "Las horas totales deben ser mayor a 0";
            isValid = false;
        }

        if (currentMateria.IdPlan <= 0)
        {
            validationErrors["Plan"] = "Debe seleccionar un plan";
            isValid = false;
        }

        // Validar duplicados
        if (isValid && !string.IsNullOrWhiteSpace(currentMateria.DescripcionMateria) && currentMateria.IdPlan > 0)
        {
            int? excludeId = mode == FormMode.Update ? currentMateria.IdMateria : null;
            bool exists = await MateriaAPIClient.ExistPlanAndDescripcionMateriaAsync(
                currentMateria.IdPlan,
                currentMateria.DescripcionMateria,
                excludeId
            );

            if (exists)
            {
                validationErrors["DescripcionMateria"] = "Ya existe una materia con esta descripción en el plan seleccionado";
                isValid = false;
            }
        }

        StateHasChanged();
        return isValid;
    }

    private void ClearValidationErrors()
    {
        validationErrors.Clear();
        errorMessage = string.Empty;
    }

    private async Task LoadPlanes()
    {
        try
        {
            planes = (await PlanAPIClient.GetAllAsync())?.ToList();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar planes: {ex.Message}";
        }
    }

    private void Close()
    {
        showModal = false;
        ClearValidationErrors();
        StateHasChanged();
    }
}
