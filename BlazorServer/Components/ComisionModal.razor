@using DTOs
@using APIClients
@inject IJSRuntime JSRuntime

@if (showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header gradient-bg text-white">
                    <h5 class="modal-title">
                        @if (mode == FormMode.Add)
                        {
                            <text>Agregar Comisión</text>
                        }
                        else
                        {
                            <text>@(IsReadOnly ? "Ver Comisión" : "Modificar Comisión")</text>
                        }
                    </h5>
                    <button type="button" class="btn-close" @onclick="Close"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="currentComision" OnValidSubmit="HandleValidSubmit">
                        <DataAnnotationsValidator />

                        @if (mode == FormMode.Update)
                        {
                            <div class="mb-3">
                                <label class="form-label">Id</label>
                                <input type="text" class="form-control" value="@currentComision.IdComision" readonly />
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label">Descripción *</label>
                            <InputText @bind-Value="currentComision.DescripcionComision"
                                       class="form-control"
                                       disabled="@IsReadOnly" />
                            @if (validationErrors.ContainsKey("DescripcionComision"))
                            {
                                <div class="text-danger small">@validationErrors["DescripcionComision"]</div>
                            }
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Año Especialidad *</label>
                            <InputNumber @bind-Value="currentComision.AnioEspecialidad"
                                         class="form-control"
                                         disabled="@IsReadOnly" />
                            @if (validationErrors.ContainsKey("AnioEspecialidad"))
                            {
                                <div class="text-danger small">@validationErrors["AnioEspecialidad"]</div>
                            }
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Plan *</label>
                            <InputSelect @bind-Value="currentComision.IdPlan"
                                         class="form-select"
                                         disabled="@IsReadOnly">
                                <option value="0">Seleccionar Plan</option>
                                @if (planes != null)
                                {
                                    @foreach (var plan in planes)
                                    {
                                        <option value="@plan.IdPlan">@plan.Descripcion - @plan.DescripcionEspecialidad</option>
                                    }
                                }
                            </InputSelect>
                            @if (validationErrors.ContainsKey("Plan"))
                            {
                                <div class="text-danger small">@validationErrors["Plan"]</div>
                            }
                        </div>

                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger">
                                @errorMessage
                            </div>
                        }

                        @if (IsReadOnly)
                        {
                            <div class="alert alert-info">
                                <i class="fas fa-info-circle"></i> No tienes permisos para modificar esta información.
                            </div>
                        }

                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-danger" @onclick="Close">
                                @(IsReadOnly ? "Cerrar" : "Cancelar")
                            </button>
                            @if (!IsReadOnly)
                            {
                                <button type="submit" class="btn btn-outline-primary" disabled="@saving">
                                    @if (saving)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2"></span>
                                    }
                                    @(mode == FormMode.Add ? "Agregar" : "Modificar")
                                </button>
                            }
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .gradient-bg {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
        border-bottom: none;
    }
</style>

@code {
    [Parameter] public EventCallback OnComisionChanged { get; set; }
    [Parameter] public bool IsReadOnly { get; set; } = false;

    private bool showModal = false;
    private FormMode mode = FormMode.Add;
    private ComisionDTO currentComision = new ComisionDTO();
    private bool saving = false;
    private string errorMessage = string.Empty;
    private Dictionary<string, string> validationErrors = new Dictionary<string, string>();
    private List<PlanDTO>? planes;

    public enum FormMode
    {
        Add,
        Update
    }

    public async Task ShowAddModal()
    {
        if (IsReadOnly)
        {
            errorMessage = "No tienes permisos para agregar comisiones.";
            return;
        }

        mode = FormMode.Add;
        currentComision = new ComisionDTO();
        await LoadPlanes();
        ClearValidationErrors();
        showModal = true;
        StateHasChanged();
    }

    public async Task ShowEditModal(ComisionDTO comision)
    {
        mode = FormMode.Update;
        currentComision = new ComisionDTO
        {
            IdComision = comision.IdComision,
            DescripcionComision = comision.DescripcionComision,
            AnioEspecialidad = comision.AnioEspecialidad,
            IdPlan = comision.IdPlan,
            DescripcionPlan = comision.DescripcionPlan,
            DescripcionEspecialidad = comision.DescripcionEspecialidad
        };
        await LoadPlanes();
        ClearValidationErrors();
        showModal = true;
        StateHasChanged();
    }

    private async Task HandleValidSubmit()
    {
        if (IsReadOnly)
        {
            errorMessage = "No tienes permisos para realizar esta acción.";
            return;
        }

        if (!await ValidateComision())
            return;

        try
        {
            saving = true;
            errorMessage = string.Empty;

            if (mode == FormMode.Add)
            {
                await ComisionAPIClient.AddAsync(currentComision);
            }
            else
            {
                await ComisionAPIClient.UpdateAsync(currentComision);
            }

            await OnComisionChanged.InvokeAsync();
            Close();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            saving = false;
        }
    }

    private async Task<bool> ValidateComision()
    {
        ClearValidationErrors();
        bool isValid = true;

        if (string.IsNullOrWhiteSpace(currentComision.DescripcionComision))
        {
            validationErrors["DescripcionComision"] = "La descripción es requerida";
            isValid = false;
        }

        if (currentComision.AnioEspecialidad <= 0)
        {
            validationErrors["AnioEspecialidad"] = "El año de especialidad debe ser mayor a 0";
            isValid = false;
        }

        if (currentComision.IdPlan <= 0)
        {
            validationErrors["Plan"] = "Debe seleccionar un plan";
            isValid = false;
        }

        // Validar duplicados
        if (isValid && currentComision.AnioEspecialidad > 0 && currentComision.IdPlan > 0)
        {
            int? excludeId = mode == FormMode.Update ? currentComision.IdComision : null;
            bool exists = await ComisionAPIClient.ExistPlanAndAnioEspecialidadAsync(
                currentComision.AnioEspecialidad,
                currentComision.IdPlan,
                excludeId
            );

            if (exists)
            {
                validationErrors["AnioEspecialidad"] = "Ya existe una comisión con este año de especialidad en el plan seleccionado";
                isValid = false;
            }
        }

        StateHasChanged();
        return isValid;
    }

    private void ClearValidationErrors()
    {
        validationErrors.Clear();
        errorMessage = string.Empty;
    }

    private async Task LoadPlanes()
    {
        try
        {
            planes = (await PlanAPIClient.GetAllAsync())?.ToList();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar planes: {ex.Message}";
        }
    }

    private void Close()
    {
        showModal = false;
        ClearValidationErrors();
        StateHasChanged();
    }
}
