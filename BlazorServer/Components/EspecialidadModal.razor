@using DTOs
@using APIClients
@using System.Text.RegularExpressions
@inject IJSRuntime JSRuntime

@if (showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        @if (mode == FormMode.Add)
                        {
                            <text>Agregar</text>
                        }
                        else
                        {
                            <text>@(IsReadOnly ? "Ver" : "Modificar")</text>
                        }
                    </h5>
                    <button type="button" class="btn-close" @onclick="Close"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="currentEspecialidad" OnValidSubmit="HandleValidSubmit">
                        <DataAnnotationsValidator />

                        @if (mode == FormMode.Update)
                        {
                            <div class="mb-3">
                                <label class="form-label">Id</label>
                                <input type="text" class="form-control" value="@currentEspecialidad.Id" readonly />
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label">Descripción *</label>
                            <InputText @bind-Value="currentEspecialidad.Descripcion"
                                       class="form-control"
                                       disabled="@IsReadOnly" />
                            @if (validationErrors.ContainsKey("Descripcion"))
                            {
                                <div class="text-danger small">@validationErrors["Descripcion"]</div>
                            }
                        </div>

                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger">
                                @errorMessage
                            </div>
                        }

                        @if (IsReadOnly)
                        {
                            <div class="alert alert-info">
                                <i class="fas fa-info-circle"></i> No tienes permisos para modificar esta información.
                            </div>
                        }

                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="Close">
                                @(IsReadOnly ? "Cerrar" : "Cancelar")
                            </button>
                            @if (!IsReadOnly)
                            {
                                <button type="submit" class="btn btn-primary" disabled="@saving">
                                    @if (saving)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2"></span>
                                    }
                                    @(mode == FormMode.Add ? "Agregar" : "Modificar")
                                </button>
                            }
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public EventCallback OnEspecialidadChanged { get; set; }
    [Parameter] public bool IsReadOnly { get; set; } = false;

    private bool showModal = false;
    private FormMode mode = FormMode.Add;
    private EspecialidadDTO currentEspecialidad = new EspecialidadDTO();
    private bool saving = false;
    private string errorMessage = string.Empty;
    private Dictionary<string, string> validationErrors = new Dictionary<string, string>();

    public enum FormMode
    {
        Add,
        Update
    }

    public async Task ShowAddModal()
    {
        if (IsReadOnly)
        {
            errorMessage = "No tienes permisos para agregar especialidades.";
            return;
        }

        mode = FormMode.Add;
        currentEspecialidad = new EspecialidadDTO();
        ClearValidationErrors();
        showModal = true;
        await InvokeAsync(StateHasChanged);
    }

    public async Task ShowEditModal(EspecialidadDTO especialidad)
    {
        mode = FormMode.Update;
        currentEspecialidad = new EspecialidadDTO
        {
            Id = especialidad.Id,
            Descripcion = especialidad.Descripcion
        };
        ClearValidationErrors();
        showModal = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleValidSubmit()
    {
        if (IsReadOnly)
        {
            errorMessage = "No tienes permisos para realizar esta acción.";
            return;
        }

        if (!ValidateEspecialidad())
            return;

        try
        {
            saving = true;
            errorMessage = string.Empty;

            if (mode == FormMode.Add)
            {
                await EspecialidadAPIClient.AddAsync(currentEspecialidad);
            }
            else
            {
                await EspecialidadAPIClient.UpdateAsync(currentEspecialidad);
            }

            await OnEspecialidadChanged.InvokeAsync();
            Close();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            saving = false;
        }
    }

    private bool ValidateEspecialidad()
    {
        ClearValidationErrors();
        bool isValid = true;

        if (string.IsNullOrWhiteSpace(currentEspecialidad.Descripcion))
        {
            validationErrors["Descripcion"] = "La descripción es requerida";
            isValid = false;
        }

        StateHasChanged();
        return isValid;
    }

    private void ClearValidationErrors()
    {
        validationErrors.Clear();
        errorMessage = string.Empty;
    }

    private void Close()
    {
        showModal = false;
        ClearValidationErrors();
        StateHasChanged();
    }
}