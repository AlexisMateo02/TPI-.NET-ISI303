@page "/especialidades"
@using DTOs
@using APIClients
@using BlazorServer.Components
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using System.IdentityModel.Tokens.Jwt
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject BlazorServer.Helpers.RoleHelper RoleHelper

<PageTitle>Especialidades</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <h3>Especialidades</h3>
            
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @errorMessage
                            <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
                        </div>
                    }
            
                    @if (!string.IsNullOrEmpty(successMessage))
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @successMessage
                            <button type="button" class="btn-close" @onclick="() => successMessage = string.Empty"></button>
                        </div>
                    }

                    @* Solo mostrar botón agregar si es Admin *@
                    @if (isAdmin)
                    {
                        <div class="mb-3">
                            <button class="btn btn-outline-primary" @onclick="OpenAddModal">
                                <i class="fas fa-plus"></i> Agregar
                            </button>
                        </div>
                    }

                    @if (loading)
                    {
                        <div class="d-flex justify-content-center">
                            <div class="spinner-border" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="gradient-bg">
                                    <tr>
                                        <th>Id</th>
                                        <th>Descripción</th>
                                        @if (isAdmin)
                                        {
                                            <th class="text-end">Acciones</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (especialidades != null && especialidades.Any())
                                    {
                                        @foreach (var especialidad in especialidades)
                                        {
                                            <tr>
                                                <td>@especialidad.Id</td>
                                                <td>@especialidad.Descripcion</td>
                                                @if (isAdmin)
                                                {
                                                    <td class="text-end">
                                                        <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => OpenEditModal(especialidad)">
                                                            <i class="fas fa-edit"></i> Modificar
                                                        </button>
                                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(especialidad)">
                                                            <i class="fas fa-trash"></i> Eliminar
                                                        </button>
                                                    </td>
                                                }
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="@(isAdmin ? 4 : 3)" class="text-center">
                                                No hay especialidades disponibles
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="container-fluid mt-5">
            <div class="alert alert-warning">
                <h4 class="alert-heading">Acceso Denegado</h4>
                <p>Debes iniciar sesión para acceder a esta página.</p>
                <hr>
                <a href="/" class="btn btn-primary">Ir a Inicio</a>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

<EspecialidadModal @ref="especialidadModal" OnEspecialidadChanged="LoadEspecialidades" IsReadOnly="@(!isAdmin)" />

<style>
    .gradient-bg {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
        color: white !important;
        border-bottom: none !important;
    }
</style>

@code {
    private List<EspecialidadDTO>? especialidades;
    private bool loading = true;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private EspecialidadModal? especialidadModal;
    private bool isAdmin = false;

    protected override async Task OnInitializedAsync()
    {
        isAdmin = await RoleHelper.IsAdminAsync();
        await LoadEspecialidades();
    }

    private async Task LoadEspecialidades()
    {
        try
        {
            loading = true;
            especialidades = (await EspecialidadAPIClient.GetAllAsync())?.ToList();
            successMessage = string.Empty;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar especialidades: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task OpenAddModal()
    {
        if (!isAdmin)
        {
            errorMessage = "No tienes permisos para realizar esta acción.";
            return;
        }

        if (especialidadModal != null)
        {
            await especialidadModal.ShowAddModal();
        }
    }

    private async Task OpenEditModal(EspecialidadDTO especialidad)
    {
        if (!isAdmin)
        {
            errorMessage = "No tienes permisos para realizar esta acción.";
            return;
        }

        if (especialidadModal != null)
        {
            await especialidadModal.ShowEditModal(especialidad);
        }
    }

    private async Task ConfirmDelete(EspecialidadDTO especialidad)
    {
        if (!isAdmin)
        {
            errorMessage = "No tienes permisos para realizar esta acción.";
            return;
        }

        var confirm = await JSRuntime.InvokeAsync<bool>("confirm", 
            $"¿Está seguro que desea eliminar la especialidad?");
        
        if (confirm)
        {
            await DeleteEspecialidad(especialidad.Id);
        }
    }

    private async Task DeleteEspecialidad(int id)
    {
        try
        {
            await EspecialidadAPIClient.DeleteAsync(id);
            successMessage = "Especialidad eliminada exitosamente.";
            await LoadEspecialidades();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al eliminar especialidad: {ex.Message}";
        }
    }
}
