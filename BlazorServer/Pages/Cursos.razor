@page "/cursos"
@using DTOs
@using APIClients
@using BlazorServer.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime
@inject BlazorServer.Helpers.RoleHelper RoleHelper

<PageTitle>Cursos</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <h3>Cursos</h3>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @errorMessage
                            <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(successMessage))
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @successMessage
                            <button type="button" class="btn-close" @onclick="() => successMessage = string.Empty"></button>
                        </div>
                    }

                    @if (isAdmin)
                    {
                        <div class="mb-3">
                            <button class="btn btn-outline-primary" @onclick="OpenAddModal">
                                <i class="fas fa-plus"></i> Agregar
                            </button>
                        </div>
                    }

                    @if (loading)
                    {
                        <div class="d-flex justify-content-center">
                            <div class="spinner-border" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="gradient-bg">
                                    <tr>
                                        <th>Id</th>
                                        <th>Año Calendario</th>
                                        <th>Cupo</th>
                                        <th>Comisión</th>
                                        <th>Materia</th>
                                        <th class="text-end">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (cursos != null && cursos.Any())
                                    {
                                        @foreach (var curso in cursos)
                                        {
                                            <tr>
                                                <td>@curso.IdCurso</td>
                                                <td>@curso.AnioCalendario</td>
                                                <td>@curso.Cupo</td>
                                                <td>@curso.DescripcionComision</td>
                                                <td>@curso.DescripcionMateria</td>
                                                <td class="text-end">
                                                    <button class="btn btn-sm btn-outline-info me-1"
                                                            @onclick="() => GenerarPdf(curso.IdCurso)"
                                                            title="Descargar PDF"
                                                            disabled="@generatingPdf">
                                                        @if (generatingPdf && pdfCursoId == curso.IdCurso)
                                                        {
                                                            <span class="spinner-border spinner-border-sm"></span>
                                                        }
                                                        else
                                                        {
                                                            <i class="fas fa-file-pdf"></i>
                                                            <span class="ms-1">Descargar PDF</span>
                                                        }
                                                    </button>

                                                    @if (isAdmin)
                                                    {
                                                        <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => OpenEditModal(curso)">
                                                            <i class="fas fa-edit"></i> Editar
                                                        </button>
                                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(curso)">
                                                            <i class="fas fa-trash"></i> Eliminar
                                                        </button>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="6" class="text-center">
                                                No hay cursos disponibles
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="container-fluid mt-5">
            <div class="alert alert-warning">
                <h4 class="alert-heading">Acceso Denegado</h4>
                <p>Debes iniciar sesión para acceder a esta página.</p>
                <hr>
                <a href="/" class="btn btn-primary">Ir a Inicio</a>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

<CursoModal @ref="cursoModal" OnCursoChanged="LoadCursos" IsReadOnly="@(!isAdmin)" />

<style>
    .gradient-bg {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
        color: white !important;
        border-bottom: none !important;
    }
</style>

@code {
    private List<CursoDTO>? cursos;
    private bool loading = true;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private CursoModal? cursoModal;
    private bool isAdmin = false;
    private bool generatingPdf = false;
    private int pdfCursoId = 0;

    protected override async Task OnInitializedAsync()
    {
        isAdmin = await RoleHelper.IsAdminAsync();
        await LoadCursos();
    }

    private async Task LoadCursos()
    {
        try
        {
            loading = true;
            cursos = (await CursoAPIClient.GetAllAsync())?.ToList();
            successMessage = string.Empty;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar cursos: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task GenerarPdf(int idCurso)
    {
        try
        {
            generatingPdf = true;
            pdfCursoId = idCurso;
            errorMessage = string.Empty;
            StateHasChanged();

            byte[] pdfBytes = await CursoAPIClient.GenerarPdfAsync(idCurso);

            var curso = cursos?.FirstOrDefault(c => c.IdCurso == idCurso);
            string fileName = $"Curso_{curso?.DescripcionMateria?.Replace(" ", "_")}_{curso?.DescripcionComision?.Replace(" ", "_")}_{curso?.AnioCalendario}.pdf";

            await JSRuntime.InvokeVoidAsync("downloadFile", fileName, Convert.ToBase64String(pdfBytes));

            successMessage = "PDF generado exitosamente.";
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al generar PDF: {ex.Message}";
        }
        finally
        {
            generatingPdf = false;
            pdfCursoId = 0;
            StateHasChanged();
        }
    }

    private async Task OpenAddModal()
    {
        if (!isAdmin)
        {
            errorMessage = "No tienes permisos para realizar esta acción.";
            return;
        }

        if (cursoModal != null)
        {
            await cursoModal.ShowAddModal();
        }
    }

    private async Task OpenEditModal(CursoDTO curso)
    {
        if (!isAdmin)
        {
            errorMessage = "No tienes permisos para realizar esta acción.";
            return;
        }

        if (cursoModal != null)
        {
            await cursoModal.ShowEditModal(curso);
        }
    }

    private async Task ConfirmDelete(CursoDTO curso)
    {
        if (!isAdmin)
        {
            errorMessage = "No tienes permisos para realizar esta acción.";
            return;
        }

        var confirm = await JSRuntime.InvokeAsync<bool>("confirm",
            $"¿Está seguro que desea eliminar el curso de '{curso.DescripcionMateria}' - '{curso.DescripcionComision}'?");

        if (confirm)
        {
            await DeleteCurso(curso.IdCurso);
        }
    }

    private async Task DeleteCurso(int id)
    {
        try
        {
            await CursoAPIClient.DeleteAsync(id);
            successMessage = "Curso eliminado exitosamente.";
            await LoadCursos();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al eliminar curso: {ex.Message}";
        }
    }
}
