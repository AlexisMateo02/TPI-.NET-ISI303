@page "/"
@using Microsoft.AspNetCore.Components.Authorization
@using DTOs
@inject BlazorServer.Services.AuthClientService AuthService
@inject NavigationManager Navigation

<PageTitle>Academia - Inicio</PageTitle>

<CascadingAuthenticationState>
    <AuthorizeView>
        <Authorized Context="authContext">
            @* Tu contenido para usuarios autenticados *@
            <div class="container-fluid">
                <div class="row justify-content-center">
                    <div class="col-md-8 text-center">
                        <div class="py-4">
                            <h1 class="display-4 fw-bold text-dark">Sistema de Gestión Universitaria</h1>
                        </div>
                        <div class="row mt-3">
                            <div class="col-12">
                                <div class="alert alert-light border-0 shadow-sm rounded-3">
                                    <div class="text-center">
                                        <h6 class="fw-bold mb-2 text-dark">¡Bienvenido @authContext.User.Identity?.Name!</h6>
                                        <p class="mb-0 text-muted small">Seleccione una de las opciones para continuar.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row justify-content-center g-2 mt-3">
                            <div class="col-12 col-md-10 col-lg-8">
                                <div class="card border-0 shadow-sm">
                                    <div class="card-body p-3">
                                        <div class="row align-items-center">
                                            <div class="col">
                                                <h6 class="card-title fw-bold mb-1">Planes</h6>
                                                <p class="card-text text-muted small mb-0">Gestión de planes académicos</p>
                                            </div>
                                            <div class="col-auto">
                                                <a href="/planes" class="btn btn-gradient btn-sm">Acceder</a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row justify-content-center g-2 mt-3">
                            <div class="col-12 col-md-10 col-lg-8">
                                <div class="card border-0 shadow-sm">
                                    <div class="card-body p-3">
                                        <div class="row align-items-center">
                                            <div class="col">
                                                <h6 class="card-title fw-bold mb-1">Especialidades</h6>
                                                <p class="card-text text-muted small mb-0">Gestión de especialidades académicas</p>
                                            </div>
                                            <div class="col-auto">
                                                <a href="/especialidades" class="btn btn-gradient btn-sm">Acceder</a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </Authorized>
        <NotAuthorized Context="loginContext">
            @* Solo mostrar login si realmente no está autenticado *@
            <div class="min-vh-100 d-flex align-items-center justify-content-center bg-primary bg-gradient">
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-md-6 col-lg-4">
                            <div class="card shadow-lg border-0 rounded-3">
                                <div class="card-header bg-white border-0 pt-4 pb-2">
                                    <div class="text-center">
                                        <i class="bi bi-mortarboard-fill text-primary display-4 mb-3"></i>
                                        <h2 class="card-title fw-bold text-dark mb-2">Iniciar Sesión</h2>
                                        <p class="text-muted mb-0">Sistema de Gestión Académica</p>
                                    </div>
                                </div>

                                <div class="card-body p-4">
                                    <EditForm Model="@loginRequest" OnValidSubmit="@HandleLogin" Context="formContext">
                                        <DataAnnotationsValidator />
                                        <ValidationSummary class="alert alert-danger" />

                                        <div class="mb-3">
                                            <label for="nombreUsuario" class="form-label fw-semibold">
                                                <i class="bi bi-person me-1"></i>Usuario
                                            </label>
                                            <InputText @bind-Value="loginRequest.NombreUsuario"
                                                       id="nombreUsuario"
                                                       class="form-control"
                                                       placeholder="Ingresa tu usuario" />
                                            <ValidationMessage For="@(() => loginRequest.NombreUsuario)" class="text-danger small" />
                                        </div>

                                        <div class="mb-4">
                                            <label for="clave" class="form-label fw-semibold">
                                                <i class="bi bi-lock me-1"></i>Contraseña
                                            </label>
                                            <InputText @bind-Value="loginRequest.Clave"
                                                       type="password"
                                                       id="clave"
                                                       class="form-control"
                                                       placeholder="Ingresa tu contraseña" />
                                            <ValidationMessage For="@(() => loginRequest.Clave)" class="text-danger small" />
                                        </div>

                                        @if (!string.IsNullOrEmpty(errorMessage))
                                        {
                                            <div class="alert alert-danger d-flex align-items-center" role="alert">
                                                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                                <div>@errorMessage</div>
                                            </div>
                                        }

                                        <div class="d-grid">
                                            <button type="submit" class="btn btn-primary py-2" disabled="@isLoading">
                                                @if (isLoading)
                                                {
                                                    <span>
                                                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                                        Iniciando sesión...
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span>
                                                        <i class="bi bi-box-arrow-in-right me-2"></i>
                                                        Iniciar Sesión
                                                    </span>
                                                }
                                            </button>
                                        </div>
                                    </EditForm>
                                </div>

                                <div class="card-footer bg-transparent border-0 text-center pb-4">
                                    <small class="text-muted">
                                        <i class="bi bi-shield-check me-1"></i>
                                        Acceso seguro al sistema
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</CascadingAuthenticationState>

<style>
    .display-4 {
        background: linear-gradient(135deg, #2c3e50, #3498db);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .btn-gradient {
        background: linear-gradient(135deg, #2c3e50, #3498db);
        border: none;
        color: white;
        font-weight: 600;
        transition: all 0.3s ease;
    }

        .btn-gradient:hover {
            background: linear-gradient(135deg, #3498db, #2c3e50);
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(52, 152, 219, 0.3);
            color: white;
        }

        .btn-gradient:active {
            transform: translateY(0);
        }

    .hover-shadow {
        transition: all 0.3s ease;
    }

        .hover-shadow:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.15) !important;
        }

    .bg-gradient {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
    }

    .card {
        transition: all 0.3s ease;
    }
</style>

@code {
    private LoginRequest loginRequest = new LoginRequest();
    private string errorMessage = string.Empty;
    private bool isLoading = false;

    private async Task HandleLogin()
    {
        isLoading = true;
        errorMessage = string.Empty;
        StateHasChanged();

        try
        {
            if (string.IsNullOrWhiteSpace(loginRequest.NombreUsuario) ||
                string.IsNullOrWhiteSpace(loginRequest.Clave))
            {
                errorMessage = "Por favor, completa todos los campos.";
                return;
            }

            var result = await AuthService.LoginAsync(loginRequest);

            if (result != null)
            {
                // Forzar navegación para refrescar el estado
                Navigation.NavigateTo("/", true);
            }
            else
            {
                errorMessage = "Credenciales inválidas. Por favor, verifica tu nombre de usuario y contraseña.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al iniciar sesión: {ex.Message}";
            Console.WriteLine($"Login error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
}