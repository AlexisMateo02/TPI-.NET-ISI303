@page "/"
@using Microsoft.AspNetCore.Components.Authorization
@using DTOs
@using System.Security.Claims
@using System.Text.Json
@using System.IdentityModel.Tokens.Jwt
@inject BlazorServer.Services.AuthClientService AuthService
@inject NavigationManager Navigation

<PageTitle>Academia - Inicio</PageTitle>

@if (!isInitialized)
{
    <div class="min-vh-100 d-flex align-items-center justify-content-center bg-primary bg-gradient">
        <div class="text-center text-white">
            <div class="spinner-border spinner-border-lg mb-3" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p>Verificando autenticación...</p>
        </div>
    </div>
}
else
{
    <CascadingAuthenticationState>
        <AuthorizeView>
            <Authorized Context="authContext">
                @{
                    var userRole = GetUserRole(authContext.User);
                    var userFunctions = GetUserFunctions(userRole);
                }

                <div class="container-fluid">
                    <div class="row justify-content-center">
                        <div class="col-md-8 text-center">
                            <div class="py-4">
                                <h1 class="display-4 fw-bold text-dark">Sistema de Gestión Universitaria</h1>
                            </div>
                            <div class="row mt-3">
                                <div class="col-12">
                                    <div class="alert alert-light border-0 shadow-sm rounded-3">
                                        <div class="text-center">
                                            <h6 class="fw-bold mb-2 text-dark">¡Bienvenido @authContext.User.Identity?.Name!</h6>
                                            <p class="mb-0 text-muted small">
                                                Rol: <span class="badge bg-primary">@GetRoleDisplayName(userRole)</span> -
                                                Seleccione una de las opciones para continuar.
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="row justify-content-center g-2 mt-3">
                                @foreach (var function in userFunctions)
                                {
                                    <div class="col-12 col-md-10 col-lg-8">
                                        <div class="card border-0 shadow-sm hover-shadow">
                                            <div class="card-body p-3">
                                                <div class="row align-items-center">
                                                    <div class="col-auto">
                                                        <i class="@function.Icon text-primary fs-3"></i>
                                                    </div>
                                                    <div class="col">
                                                        <h6 class="card-title fw-bold mb-1">@function.Title</h6>
                                                        <p class="card-text text-muted small mb-0">@function.Description</p>
                                                    </div>
                                                    <div class="col-auto">
                                                        <a href="@function.Url" class="btn btn-gradient btn-sm">Acceder</a>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="min-vh-100 d-flex align-items-center justify-content-center bg-primary bg-gradient">
                    <div class="container">
                        <div class="row justify-content-center">
                            <div class="col-md-6 col-lg-4">
                                <div class="card shadow-lg border-0 rounded-3">
                                    <div class="card-header bg-white border-0 pt-4 pb-2">
                                        <div class="text-center">
                                            <i class="bi bi-mortarboard-fill text-primary display-4 mb-3"></i>
                                            <h2 class="card-title fw-bold text-dark mb-2">Iniciar Sesión</h2>
                                            <p class="text-muted mb-0">Sistema de Gestión Académica</p>
                                        </div>
                                    </div>

                                    <div class="card-body p-4">
                                        <EditForm Model="@loginRequest" OnValidSubmit="@HandleLogin" Context="formContext">
                                            <DataAnnotationsValidator />

                                            <div class="mb-3">
                                                <label for="nombreUsuario" class="form-label fw-semibold">
                                                    <i class="bi bi-person me-1"></i>Usuario
                                                </label>
                                                <InputText @bind-Value="loginRequest.NombreUsuario"
                                                           id="nombreUsuario"
                                                           class="form-control"
                                                           placeholder="Ingresa tu usuario" />
                                                <ValidationMessage For="@(() => loginRequest.NombreUsuario)" class="text-danger small" />
                                            </div>

                                            <div class="mb-4">
                                                <label for="clave" class="form-label fw-semibold">
                                                    <i class="bi bi-lock me-1"></i>Contraseña
                                                </label>
                                                <InputText @bind-Value="loginRequest.Clave"
                                                           type="password"
                                                           id="clave"
                                                           class="form-control"
                                                           placeholder="Ingresa tu contraseña" />
                                                <ValidationMessage For="@(() => loginRequest.Clave)" class="text-danger small" />
                                            </div>

                                            @if (!string.IsNullOrEmpty(errorMessage))
                                            {
                                                <div class="alert alert-danger d-flex align-items-center" role="alert">
                                                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                                    <div>@errorMessage</div>
                                                </div>
                                            }

                                            <div class="d-grid">
                                                <button type="submit" class="btn btn-primary py-2" disabled="@isLoading">
                                                    @if (isLoading)
                                                    {
                                                        <span>
                                                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                                            Iniciando sesión...
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span>
                                                            <i class="bi bi-box-arrow-in-right me-2"></i>
                                                            Iniciar Sesión
                                                        </span>
                                                    }
                                                </button>
                                            </div>
                                        </EditForm>
                                    </div>

                                    <div class="card-footer bg-transparent border-0 text-center pb-4">
                                        <small class="text-muted">
                                            <i class="bi bi-shield-check me-1"></i>
                                            Si usted olvidado su contraseña,
                                            contactese con la administración
                                        </small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </CascadingAuthenticationState>
}

<style>
    .display-4 {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .btn-gradient {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        color: white;
        font-weight: 600;
        transition: all 0.3s ease;
    }

        .btn-gradient:hover {
            background: linear-gradient(135deg, #764ba2 0%, #667eea 100%);
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(52, 152, 219, 0.3);
            color: white;
        }

        .btn-gradient:active {
            transform: translateY(0);
        }

    .hover-shadow {
        transition: all 0.3s ease;
    }

        .hover-shadow:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.15) !important;
        }

    .bg-gradient {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
    }

    .card {
        transition: all 0.3s ease;
    }
</style>

@code {
    private LoginRequest loginRequest = new LoginRequest();
    private string errorMessage = string.Empty;
    private bool isLoading = false;
    private bool isInitialized = false;

    private class SystemFunction
    {
        public string Title { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string Url { get; set; } = string.Empty;
        public string Icon { get; set; } = "bi-app";
        public List<int> AllowedRoles { get; set; } = new List<int>();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !isInitialized)
        {
            await CheckTokenExpiration();
            isInitialized = true;
            StateHasChanged();
        }
    }

    private async Task CheckTokenExpiration()
    {
        try
        {
            var token = await AuthService.GetTokenAsync();
            if (!string.IsNullOrEmpty(token) && IsTokenExpired(token))
            {
                await AuthService.LogoutAsync();
            }
        }
        catch { }
    }

    private bool IsTokenExpired(string jwtToken)
    {
        try
        {
            var handler = new JwtSecurityTokenHandler();
            var token = handler.ReadJwtToken(jwtToken);
            return token.ValidTo <= DateTime.UtcNow;
        }
        catch
        {
            return true;
        }
    }

    private string GetUserRole(ClaimsPrincipal user)
    {
        try
        {
            var tokenClaim = user.FindFirst("token");
            if (tokenClaim != null)
            {
                var handler = new JwtSecurityTokenHandler();
                var token = handler.ReadJwtToken(tokenClaim.Value);
                var roleClaim = token.Claims.FirstOrDefault(c => c.Type == "rol");
                if (roleClaim != null) return roleClaim.Value;
            }

            var roleClaim2 = user.FindFirst("rol") ?? user.FindFirst(ClaimTypes.Role);
            if (roleClaim2 != null) return roleClaim2.Value;

            return "3";
        }
        catch
        {
            return "3";
        }
    }

    private string GetRoleDisplayName(string role)
    {
        return role switch
        {
            "1" => "Administrador",
            "2" => "Docente",
            "3" => "Alumno",
            _ => "Usuario"
        };
    }

    private List<SystemFunction> GetUserFunctions(string userRole)
    {
        var allFunctions = new List<SystemFunction>
        {
            new SystemFunction
            {
                Title = "Gestión de Usuarios",
                Description = "Administrar usuarios y permisos del sistema",
                Url = "/usuarios",
                Icon = "bi-people-fill",
                AllowedRoles = new List<int> { 1 }
            },
            new SystemFunction
            {
                Title = "Planes Académicos",
                Description = "Gestionar planes de estudio",
                Url = "/planes",
                Icon = "bi-journal-bookmark-fill",
                AllowedRoles = new List<int> { 1, 2 }
            },
            new SystemFunction
            {
                Title = "Especialidades",
                Description = "Gestionar especialidades académicas",
                Url = "/especialidades",
                Icon = "bi-mortarboard-fill",
                AllowedRoles = new List<int> { 1, 2 }
            },
            new SystemFunction
            {
                Title = "Cursos",
                Description = "Gestionar cursos y materias",
                Url = "/cursos",
                Icon = "bi-book-fill",
                AllowedRoles = new List<int> { 1, 2 }
            },
            new SystemFunction
            {
                Title = "Mis Cursos",
                Description = "Ver mis cursos asignados",
                Url = "/mis-cursos",
                Icon = "bi-collection-fill",
                AllowedRoles = new List<int> { 2, 3 }
            },
            new SystemFunction
            {
                Title = "Inscripciones",
                Description = "Inscribirse a cursos disponibles",
                Url = "/inscripciones",
                Icon = "bi-pencil-square",
                AllowedRoles = new List<int> { 3 }
            },
            new SystemFunction
            {
                Title = "Calificaciones",
                Description = "Consultar calificaciones",
                Url = "/calificaciones",
                Icon = "bi-clipboard-data-fill",
                AllowedRoles = new List<int> { 3 }
            },
            new SystemFunction
            {
                Title = "Reportes",
                Description = "Generar reportes del sistema",
                Url = "/reportes",
                Icon = "bi-file-earmark-bar-graph-fill",
                AllowedRoles = new List<int> { 1 }
            },
            new SystemFunction
            {
                Title = "Configuración",
                Description = "Configurar parámetros del sistema",
                Url = "/configuracion",
                Icon = "bi-gear-fill",
                AllowedRoles = new List<int> { 1 }
            }
        };

        return allFunctions
            .Where(f => f.AllowedRoles.Contains(int.Parse(userRole)))
            .ToList();
    }

    private async Task HandleLogin()
    {
        isLoading = true;
        errorMessage = string.Empty;
        StateHasChanged();

        try
        {
            var result = await AuthService.LoginAsync(loginRequest);

            if (result != null)
            {
                Navigation.NavigateTo("/", true);
            }
            else
            {
                errorMessage = "Credenciales inválidas. Por favor, verifica tu nombre de usuario y contraseña.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al iniciar sesión: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
}