@page "/materias"
@using DTOs
@using APIClients
@using BlazorServer.Components
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using System.IdentityModel.Tokens.Jwt
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject BlazorServer.Helpers.RoleHelper RoleHelper

<PageTitle>Materias</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <h3>Materias</h3>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @errorMessage
                            <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(successMessage))
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @successMessage
                            <button type="button" class="btn-close" @onclick="() => successMessage = string.Empty"></button>
                        </div>
                    }

                    @if (isAdmin)
                    {
                        <div class="mb-3">
                            <button class="btn btn-outline-primary" @onclick="OpenAddModal">
                                <i class="fas fa-plus"></i> Agregar
                            </button>
                        </div>
                    }

                    @if (loading)
                    {
                        <div class="d-flex justify-content-center">
                            <div class="spinner-border" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="gradient-bg">
                                    <tr>
                                        <th>Id</th>
                                        <th>Descripción</th>
                                        <th>Horas Semanales</th>
                                        <th>Horas Totales</th>
                                        <th>Plan</th>
                                        <th>Especialidad</th>
                                        @if (isAdmin)
                                        {
                                            <th class="text-end">Acciones</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (materias != null && materias.Any())
                                    {
                                        @foreach (var materia in materias)
                                        {
                                            <tr>
                                                <td>@materia.IdMateria</td>
                                                <td>@materia.DescripcionMateria</td>
                                                <td>@materia.HorasSemanales</td>
                                                <td>@materia.HorasTotales</td>
                                                <td>@materia.DescripcionPlan</td>
                                                <td>@materia.DescripcionEspecialidad</td>
                                                @if (isAdmin)
                                                {
                                                    <td class="text-end">
                                                        <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => OpenEditModal(materia)">
                                                            <i class="fas fa-edit"></i> Editar
                                                        </button>
                                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(materia)">
                                                            <i class="fas fa-trash"></i> Eliminar
                                                        </button>
                                                    </td>
                                                }
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="@(isAdmin ? 7 : 6)" class="text-center">
                                                No hay materias disponibles
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="container-fluid mt-5">
            <div class="alert alert-warning">
                <h4 class="alert-heading">Acceso Denegado</h4>
                <p>Debes iniciar sesión para acceder a esta página.</p>
                <hr>
                <a href="/" class="btn btn-primary">Ir a Inicio</a>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

<MateriaModal @ref="materiaModal" OnMateriaChanged="LoadMaterias" IsReadOnly="@(!isAdmin)" />

<style>
    .gradient-bg {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
        color: white !important;
        border-bottom: none !important;
    }
</style>

@code {
    private List<MateriaDTO>? materias;
    private bool loading = true;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private MateriaModal? materiaModal;
    private bool isAdmin = false;

    protected override async Task OnInitializedAsync()
    {
        isAdmin = await RoleHelper.IsAdminAsync();
        await LoadMaterias();
    }

    private async Task LoadMaterias()
    {
        try
        {
            loading = true;
            materias = (await MateriaAPIClient.GetAllAsync())?.ToList();
            successMessage = string.Empty;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar materias: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task OpenAddModal()
    {
        if (!isAdmin)
        {
            errorMessage = "No tienes permisos para realizar esta acción.";
            return;
        }

        if (materiaModal != null)
        {
            await materiaModal.ShowAddModal();
        }
    }

    private async Task OpenEditModal(MateriaDTO materia)
    {
        if (!isAdmin)
        {
            errorMessage = "No tienes permisos para realizar esta acción.";
            return;
        }

        if (materiaModal != null)
        {
            await materiaModal.ShowEditModal(materia);
        }
    }

    private async Task ConfirmDelete(MateriaDTO materia)
    {
        if (!isAdmin)
        {
            errorMessage = "No tienes permisos para realizar esta acción.";
            return;
        }

        var confirm = await JSRuntime.InvokeAsync<bool>("confirm",
            $"¿Está seguro que desea eliminar la materia '{materia.DescripcionMateria}'?");

        if (confirm)
        {
            await DeleteMateria(materia.IdMateria);
        }
    }

    private async Task DeleteMateria(int id)
    {
        try
        {
            await MateriaAPIClient.DeleteAsync(id);
            successMessage = "Materia eliminada exitosamente.";
            await LoadMaterias();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al eliminar materia: {ex.Message}";
        }
    }
}
