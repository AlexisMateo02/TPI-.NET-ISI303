@page "/inscripciones"
@using DTOs
@using APIClients
@using BlazorServer.Components
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using System.IdentityModel.Tokens.Jwt
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject BlazorServer.Helpers.RoleHelper RoleHelper

<PageTitle>Inscripciones</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <h3>
                        @if (isAdmin)
                        {
                            <text>Inscripciones</text>
                        }
                        else if (isDocente)
                        {
                            <text>Mis Cursos - Notas</text>
                        }
                        else
                        {
                            <text>Mis Inscripciones</text>
                        }
                    </h3>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @errorMessage
                            <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(successMessage))
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @successMessage
                            <button type="button" class="btn-close" @onclick="() => successMessage = string.Empty"></button>
                        </div>
                    }

                    @if (isAdmin || isAlumno)
                    {
                        <div class="mb-3">
                            <button class="btn btn-outline-primary" @onclick="OpenAddModal">
                                <i class="fas fa-plus"></i> @(isAdmin ? "Agregar Inscripción" : "Inscribirse a Curso")
                            </button>
                        </div>
                    }

                    @if (loading)
                    {
                        <div class="d-flex justify-content-center">
                            <div class="spinner-border" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="gradient-bg">
                                    <tr>
                                        <th>Id</th>
                                        @if (isAdmin || isDocente)
                                        {
                                            <th>Alumno</th>
                                            <th>Legajo</th>
                                        }
                                        <th>Materia</th>
                                        <th>Comisión</th>
                                        <th>Año</th>
                                        <th>Condición</th>
                                        <th>Nota</th>
                                        <th class="text-end">Acciones Disponibles</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (inscripciones != null && inscripciones.Any())
                                    {
                                        @foreach (var inscripcion in inscripciones)
                                        {
                                            <tr>
                                                <td>@inscripcion.IdInscripcion</td>
                                                @if (isAdmin || isDocente)
                                                {
                                                    <td>@inscripcion.NombreCompletoPersona</td>
                                                    <td>@inscripcion.Legajo</td>
                                                }
                                                <td>@inscripcion.DescripcionMateria</td>
                                                <td>@inscripcion.DescripcionComision</td>
                                                <td>@inscripcion.AnioCalendario</td>
                                                <td>
                                                    <span class="badge @GetCondicionBadgeClass(inscripcion.Condicion)">
                                                        @inscripcion.Condicion
                                                    </span>
                                                </td>
                                                <td>
                                                    @if (inscripcion.Nota.HasValue)
                                                    {
                                                        <span class="badge @GetNotaBadgeClass(inscripcion.Nota.Value)">
                                                            @inscripcion.Nota.Value
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">-</span>
                                                    }
                                                </td>
                                                <td class="text-end">
                                                    @if (isAdmin)
                                                    {
                                                        @* Admin puede editar si NO está aprobado *@
                                                        @if (inscripcion.Condicion != "Aprobado")
                                                        {
                                                            <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => OpenEditModal(inscripcion)">
                                                                <i class="fas fa-edit"></i> Editar
                                                            </button>
                                                        }
                                                        else
                                                        {
                                                            <button class="btn btn-sm btn-outline-success me-1" disabled title="No se puede editar una inscripción aprobada">
                                                                <i class="fas fa-check-circle"></i> Aprobado
                                                            </button>
                                                        }

                                                        @* Admin puede eliminar solo si está Cursando y no tiene nota *@
                                                        @if (!inscripcion.Nota.HasValue && inscripcion.Condicion == "Cursando")
                                                        {
                                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(inscripcion)">
                                                                <i class="fas fa-trash"></i> Eliminar
                                                            </button>
                                                        }
                                                    }
                                                    else if (isDocente && canEditNotas)
                                                    {
                                                        @* Docente puede calificar si NO está aprobado *@
                                                        @if (inscripcion.Condicion != "Aprobado")
                                                        {
                                                            <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenEditNotaModal(inscripcion)">
                                                                <i class="fas fa-edit"></i> Calificar
                                                            </button>
                                                        }
                                                        else
                                                        {
                                                            <button class="btn btn-sm btn-outline-success" disabled>
                                                                <i class="fas fa-check-circle"></i> Aprobado
                                                            </button>
                                                        }
                                                    }
                                                    else if (isAlumno)
                                                    {
                                                        @* Alumno solo puede desinscribirse si está "Cursando" y no tiene nota *@
                                                        @if (inscripcion.Condicion == "Cursando" && !inscripcion.Nota.HasValue)
                                                        {
                                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(inscripcion)">
                                                                <i class="fas fa-user-times"></i> Desincribirse
                                                            </button>
                                                        }
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="@GetColSpan()" class="text-center">
                                                @if (isAlumno)
                                                {
                                                    <text>No tienes inscripciones. ¡Inscríbete a un curso!</text>
                                                }
                                                else if (isDocente)
                                                {
                                                    <text>No hay inscripciones en tus cursos</text>
                                                }
                                                else
                                                {
                                                    <text>No hay inscripciones disponibles</text>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="container-fluid mt-5">
            <div class="alert alert-warning">
                <h4 class="alert-heading">Acceso Denegado</h4>
                <p>Debes iniciar sesión para acceder a esta página.</p>
                <hr>
                <a href="/" class="btn btn-primary">Ir a Inicio</a>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

<InscripcionModal @ref="inscripcionModal" OnInscripcionChanged="LoadInscripciones"
                  IsAdmin="@isAdmin" IsDocente="@isDocente" IsAlumno="@isAlumno"
                  CurrentUserId="@currentUserId" />

<style>
    .gradient-bg {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
        color: white !important;
        border-bottom: none !important;
    }
</style>

@code {
    private List<AlumnoInscripcionDTO>? inscripciones;
    private bool loading = true;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private InscripcionModal? inscripcionModal;
    private bool isAdmin = false;
    private bool isDocente = false;
    private bool isAlumno = false;
    private bool canEditNotas = true;
    private int currentUserId = 0;

    protected override async Task OnInitializedAsync()
    {
        isAdmin = await RoleHelper.IsAdminAsync();
        isDocente = await RoleHelper.IsDocenteAsync();
        isAlumno = await RoleHelper.IsAlumnoAsync();

        await GetCurrentUserId();
        await LoadInscripciones();
    }

    private async Task GetCurrentUserId()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity?.IsAuthenticated == true)
            {
                var idPersonaClaim = user.FindFirst("idPersona")
                                   ?? user.FindFirst("personaId")
                                   ?? user.FindFirst("IdPersona");

                if (idPersonaClaim != null && int.TryParse(idPersonaClaim.Value, out int id))
                {
                    currentUserId = id;
                    return;
                }

                var username = user.Identity.Name;
                if (!string.IsNullOrEmpty(username))
                {
                    await GetPersonaIdFromUsername(username);
                    return;
                }

                errorMessage = "No se pudo identificar tu información. Contacta al administrador.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al obtener usuario actual: {ex.Message}";
        }
    }

    private async Task GetPersonaIdFromUsername(string username)
    {
        try
        {
            var usuarios = await UsuarioAPIClient.GetAllAsync();
            var usuario = usuarios?.FirstOrDefault(u =>
                u.NombreUsuario.Equals(username, StringComparison.OrdinalIgnoreCase));

            if (usuario != null && usuario.IdPersona.HasValue)
            {
                currentUserId = usuario.IdPersona.Value;

                if (isAlumno)
                {
                    var persona = await PersonaAPIClient.GetAsync(currentUserId);
                    if (persona != null && persona.TipoPersona != 1)
                    {
                        errorMessage = "Tu usuario no tiene permisos de alumno. Contacta al administrador.";
                        currentUserId = 0;
                    }
                }
            }
        }
        catch
        {
            errorMessage = "Error al obtener información del usuario.";
        }
    }

    private async Task LoadInscripciones()
    {
        try
        {
            loading = true;
            var todasInscripciones = (await AlumnoInscripcionAPIClient.GetAllAsync())?.ToList();

            if (isAlumno && currentUserId > 0)
            {
                inscripciones = todasInscripciones?.Where(i => i.IdAlumno == currentUserId).ToList();
            }
            else if (isDocente && currentUserId > 0)
            {
                inscripciones = await GetInscripcionesDeMisCursos(currentUserId);
            }
            else
            {
                inscripciones = todasInscripciones;
            }

            successMessage = string.Empty;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar inscripciones: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task OpenAddModal()
    {
        if (inscripcionModal != null)
        {
            await inscripcionModal.ShowAddModal();
        }
    }

    private async Task OpenEditModal(AlumnoInscripcionDTO inscripcion)
    {
        if (!isAdmin)
        {
            errorMessage = "No tienes permisos para realizar esta acción.";
            return;
        }

        if (inscripcion.Condicion == "Aprobado")
        {
            errorMessage = "No se puede editar una inscripción con condición 'Aprobado'.";
            return;
        }

        if (inscripcionModal != null)
        {
            await inscripcionModal.ShowEditModal(inscripcion);
        }
    }

    private async Task OpenEditNotaModal(AlumnoInscripcionDTO inscripcion)
    {
        if (!isDocente)
        {
            errorMessage = "No tienes permisos para realizar esta acción.";
            return;
        }

        if (inscripcion.Condicion == "Aprobado")
        {
            errorMessage = "Esta inscripción ya está aprobada y no puede ser modificada.";
            return;
        }

        if (!await PuedeCalificarCurso(inscripcion.IdCurso))
        {
            errorMessage = "No tienes permisos para calificar en este curso.";
            return;
        }

        if (inscripcionModal != null)
        {
            await inscripcionModal.ShowEditNotaModal(inscripcion);
        }
    }

    private async Task ConfirmDelete(AlumnoInscripcionDTO inscripcion)
    {
        if (!isAdmin && !isAlumno)
        {
            errorMessage = "No tienes permisos para realizar esta acción.";
            return;
        }

        if (isAlumno && inscripcion.IdAlumno != currentUserId)
        {
            errorMessage = "Solo puedes desinscribirte de tus propias inscripciones.";
            return;
        }

        if (!CanDelete(inscripcion))
        {
            errorMessage = $"No se puede eliminar esta inscripción: {GetDeleteRestrictionReason(inscripcion)}";
            return;
        }

        var message = isAlumno
            ? $"¿Está seguro que desea desincribirse de '{inscripcion.DescripcionMateria}'?"
            : $"¿Está seguro que desea eliminar la inscripción de '{inscripcion.NombreCompletoPersona}' en '{inscripcion.DescripcionMateria}'?";

        var confirm = await JSRuntime.InvokeAsync<bool>("confirm", message);

        if (confirm)
        {
            await DeleteInscripcion(inscripcion.IdInscripcion);
        }
    }

    private async Task DeleteInscripcion(int id)
    {
        try
        {
            await AlumnoInscripcionAPIClient.DeleteAsync(id);
            successMessage = isAlumno ? "Te has desinscrito exitosamente." : "Inscripción eliminada exitosamente.";
            await LoadInscripciones();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al eliminar inscripción: {ex.Message}";
        }
    }

    private bool CanDelete(AlumnoInscripcionDTO inscripcion)
    {
        return inscripcion.Condicion == "Cursando" && !inscripcion.Nota.HasValue;
    }

    private string GetDeleteRestrictionReason(AlumnoInscripcionDTO inscripcion)
    {
        if (inscripcion.Condicion == "Aprobado")
        {
            return "La materia está aprobada";
        }

        if (inscripcion.Nota.HasValue)
        {
            return "Ya tiene nota asignada";
        }

        if (inscripcion.Condicion != "Cursando")
        {
            return $"Condición '{inscripcion.Condicion}' no permite eliminación";
        }

        return "Restricción del sistema";
    }

    private async Task<List<AlumnoInscripcionDTO>?> GetInscripcionesDeMisCursos(int idDocente)
    {
        try
        {
            var misDictados = (await DocenteCursoAPIClient.GetAllAsync())?
                .Where(d => d.IdDocente == idDocente)
                .ToList();

            if (misDictados == null || !misDictados.Any())
                return new List<AlumnoInscripcionDTO>();

            var misCursosIds = misDictados.Select(d => d.IdCurso).Distinct().ToList();

            var todasInscripciones = (await AlumnoInscripcionAPIClient.GetAllAsync())?.ToList();

            return todasInscripciones?
                .Where(i => misCursosIds.Contains(i.IdCurso))
                .ToList();
        }
        catch
        {
            return new List<AlumnoInscripcionDTO>();
        }
    }

    private async Task<bool> PuedeCalificarCurso(int idCurso)
    {
        try
        {
            var misDictados = (await DocenteCursoAPIClient.GetAllAsync())?
                .Where(d => d.IdDocente == currentUserId
                         && d.IdCurso == idCurso
                         && (d.Cargo.ToLower() == "titular"
                             || d.Cargo.ToLower() == "adjunto"))
                .ToList();

            return misDictados != null && misDictados.Any();
        }
        catch
        {
            return false;
        }
    }

    private string GetCondicionBadgeClass(string condicion)
    {
        return condicion?.ToLower() switch
        {
            "cursando" => "bg-info",
            "regular" => "bg-success",
            "aprobado" => "bg-primary",
            "libre" => "bg-warning text-dark",
            _ => "bg-secondary"
        };
    }

    private string GetNotaBadgeClass(int nota)
    {
        if (nota >= 6) return "bg-success";
        if (nota >= 4) return "bg-warning text-dark";
        return "bg-danger";
    }

    private int GetColSpan()
    {
        if (isAdmin || isDocente) return 9;
        return 7;
    }
}