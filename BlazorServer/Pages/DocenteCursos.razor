@page "/docentecursos"
@using DTOs
@using APIClients
@using BlazorServer.Components
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using System.IdentityModel.Tokens.Jwt
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject BlazorServer.Helpers.RoleHelper RoleHelper
@inject BlazorServer.Services.AuthClientService AuthService

<PageTitle>Docente por Cursos</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <h3>@(isAdmin ? "Dictados" : "Mis Dictados")</h3>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @errorMessage
                            <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(successMessage))
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @successMessage
                            <button type="button" class="btn-close" @onclick="() => successMessage = string.Empty"></button>
                        </div>
                    }

                    @if (isAdmin)
                    {
                        <div class="mb-3">
                            <button class="btn btn-outline-primary" @onclick="OpenAddModal">
                                <i class="fas fa-plus"></i> Agregar
                            </button>
                        </div>
                    }

                    @if (loading)
                    {
                        <div class="d-flex justify-content-center">
                            <div class="spinner-border" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="gradient-bg">
                                    <tr>
                                        <th>Id</th>
                                        <th>Cargo</th>
                                        @if (isAdmin)
                                        {
                                            <th>Docente</th>
                                            <th>Legajo</th>
                                        }
                                        <th>Año</th>
                                        <th>Comisión</th>
                                        <th>Materia</th>
                                        @if (isAdmin)
                                        {
                                            <th class="text-end">Acciones</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (docenteCursos != null && docenteCursos.Any())
                                    {
                                        @foreach (var dictado in docenteCursos)
                                        {
                                            <tr>
                                                <td>@dictado.IdDictado</td>
                                                <td>
                                                    <span class="badge @GetCargoBadgeClass(dictado.Cargo)">
                                                        @dictado.Cargo
                                                    </span>
                                                </td>
                                                @if (isAdmin)
                                                {
                                                    <td>@dictado.NombreCompletoPersona</td>
                                                    <td>@dictado.Legajo</td>
                                                }
                                                <td>@dictado.AnioCalendario</td>
                                                <td>@dictado.DescripcionComision</td>
                                                <td>@dictado.DescripcionMateria</td>
                                                @if (isAdmin)
                                                {
                                                    <td class="text-end">
                                                        <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => OpenEditModal(dictado)">
                                                            <i class="fas fa-edit"></i> Editar
                                                        </button>
                                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(dictado)">
                                                            <i class="fas fa-trash"></i> Eliminar
                                                        </button>
                                                    </td>
                                                }
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="@(isAdmin ? 8 : 5)" class="text-center">
                                                @if (isDocente)
                                                {
                                                    <text>No tienes dictados asignados</text>
                                                }
                                                else
                                                {
                                                    <text>No hay dictados disponibles</text>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="container-fluid mt-5">
            <div class="alert alert-warning">
                <h4 class="alert-heading">Acceso Denegado</h4>
                <p>Debes iniciar sesión para acceder a esta página.</p>
                <hr>
                <a href="/" class="btn btn-primary">Ir a Inicio</a>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

<DocenteCursoModal @ref="docenteCursoModal" OnDocenteCursoChanged="LoadDocenteCursos" IsReadOnly="@(!isAdmin)" />

<style>
    .gradient-bg {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
        color: white !important;
        border-bottom: none !important;
    }
</style>

@code {
    private List<DocenteCursoDTO>? docenteCursos;
    private bool loading = true;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private DocenteCursoModal? docenteCursoModal;
    private bool isAdmin = false;
    private bool isDocente = false;
    private int currentUserId = 0;

    protected override async Task OnInitializedAsync()
    {
        isAdmin = await RoleHelper.IsAdminAsync();
        isDocente = await RoleHelper.IsDocenteAsync();

        if (isDocente)
        {
            await GetCurrentUserId();
        }

        await LoadDocenteCursos();
    }

    private async Task GetCurrentUserId()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity?.IsAuthenticated == true)
            {
                var idPersonaClaim = user.FindFirst("idPersona")
                                   ?? user.FindFirst("personaId")
                                   ?? user.FindFirst("IdPersona");

                if (idPersonaClaim != null && int.TryParse(idPersonaClaim.Value, out int id))
                {
                    currentUserId = id;
                    return;
                }

                var username = user.Identity.Name;
                if (!string.IsNullOrEmpty(username))
                {
                    await GetPersonaIdFromUsername(username);
                    return;
                }

                errorMessage = "No se pudo identificar tu información de docente. Contacta al administrador.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al obtener usuario actual: {ex.Message}";
        }
    }

    private async Task GetPersonaIdFromUsername(string username)
    {
        try
        {
            var usuarios = await UsuarioAPIClient.GetAllAsync();
            var usuario = usuarios?.FirstOrDefault(u =>
                u.NombreUsuario.Equals(username, StringComparison.OrdinalIgnoreCase));

            if (usuario != null && usuario.IdPersona.HasValue)
            {
                currentUserId = usuario.IdPersona.Value;

                var persona = await PersonaAPIClient.GetAsync(currentUserId);
                if (persona != null && persona.TipoPersona != 2)
                {
                    errorMessage = "Tu usuario no tiene permisos de docente. Contacta al administrador.";
                    currentUserId = 0;
                }
            }
        }
        catch
        {
            errorMessage = "Error al obtener información del docente.";
        }
    }

    private async Task LoadDocenteCursos()
    {
        try
        {
            loading = true;
            var todosDictados = (await DocenteCursoAPIClient.GetAllAsync())?.ToList();

            if (isDocente && currentUserId > 0)
            {
                // Filtrar solo los dictados del docente actual
                docenteCursos = todosDictados?.Where(d => d.IdDocente == currentUserId).ToList();
            }
            else
            {
                // Admin ve todos los dictados
                docenteCursos = todosDictados;
            }

            successMessage = string.Empty;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar dictados: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task OpenAddModal()
    {
        if (!isAdmin)
        {
            errorMessage = "No tienes permisos para realizar esta acción.";
            return;
        }

        if (docenteCursoModal != null)
        {
            await docenteCursoModal.ShowAddModal();
        }
    }

    private async Task OpenEditModal(DocenteCursoDTO dictado)
    {
        if (!isAdmin)
        {
            errorMessage = "No tienes permisos para realizar esta acción.";
            return;
        }

        if (docenteCursoModal != null)
        {
            await docenteCursoModal.ShowEditModal(dictado);
        }
    }

    private async Task ConfirmDelete(DocenteCursoDTO dictado)
    {
        if (!isAdmin)
        {
            errorMessage = "No tienes permisos para realizar esta acción.";
            return;
        }

        var confirm = await JSRuntime.InvokeAsync<bool>("confirm",
            $"¿Está seguro que desea eliminar el dictado de '{dictado.NombreCompletoPersona}' en '{dictado.DescripcionMateria}'?");

        if (confirm)
        {
            await DeleteDocenteCurso(dictado.IdDictado);
        }
    }

    private async Task DeleteDocenteCurso(int id)
    {
        try
        {
            await DocenteCursoAPIClient.DeleteAsync(id);
            successMessage = "Dictado eliminado exitosamente.";
            await LoadDocenteCursos();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al eliminar dictado: {ex.Message}";
        }
    }

    private string GetCargoBadgeClass(string cargo)
    {
        return cargo?.ToLower() switch
        {
            "titular" => "bg-primary",
            "adjunto" => "bg-success",
            "auxiliar" => "bg-warning text-dark",
            _ => "bg-secondary"
        };
    }
}