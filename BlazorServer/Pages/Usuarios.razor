@page "/usuarios"
@using DTOs
@using APIClients
@using BlazorServer.Components
@using Microsoft.AspNetCore.Components.Authorization
@inject IJSRuntime JSRuntime
@inject BlazorServer.Helpers.RoleHelper RoleHelper
@inject BlazorServer.Services.AuthClientService AuthService

<PageTitle>Usuarios</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h3>Gestión de Usuarios</h3>
                        @if (!isAdmin)
                        {
                            <button class="btn btn-warning" @onclick="OpenChangePasswordModal">
                                <i class="fas fa-key"></i> Cambiar mi Contraseña
                            </button>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @errorMessage
                            <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(successMessage))
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @successMessage
                            <button type="button" class="btn-close" @onclick="() => successMessage = string.Empty"></button>
                        </div>
                    }

                    @if (isAdmin)
                    {
                        <div class="card mb-3">
                            <div class="card-body">
                                <div class="row g-2">
                                    <div class="col-md-8">
                                        <input type="text"
                                               class="form-control"
                                               placeholder="Buscar por nombre de usuario, nombre, apellido o legajo..."
                                               @bind="searchText"
                                               @bind:event="oninput"
                                               @onkeyup="HandleSearchKeyUp" />
                                    </div>
                                    <div class="col-md-2">
                                        <button class="btn btn-primary w-100" @onclick="SearchUsuarios">
                                            <i class="fas fa-search"></i> Buscar
                                        </button>
                                    </div>
                                    <div class="col-md-2">
                                        <button class="btn btn-success w-100" @onclick="OpenAddModal">
                                            <i class="fas fa-plus"></i> Agregar
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @if (loading)
                        {
                            <div class="d-flex justify-content-center">
                                <div class="spinner-border" role="status">
                                    <span class="visually-hidden">Cargando...</span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-striped table-hover">
                                    <thead class="table-dark">
                                        <tr>
                                            <th>ID</th>
                                            <th>Usuario</th>
                                            <th>Persona</th>
                                            <th>Legajo</th>
                                            <th>Rol</th>
                                            <th>Estado</th>
                                            <th>Fecha Alta</th>
                                            <th class="text-end">Acciones</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (usuarios != null && usuarios.Any())
                                        {
                                            @foreach (var usuario in usuarios)
                                            {
                                                <tr>
                                                    <td>@usuario.Id</td>
                                                    <td>@usuario.NombreUsuario</td>
                                                    <td>@(string.IsNullOrEmpty(usuario.NombreCompletoPersona) ? "-" : usuario.NombreCompletoPersona)</td>
                                                    <td>@(usuario.Legajo?.ToString() ?? "-")</td>
                                                    <td>
                                                        <span class="badge @GetRoleBadgeClass(usuario.Rol)">
                                                            @GetRoleDisplayName(usuario.Rol)
                                                        </span>
                                                    </td>
                                                    <td>
                                                        <span class="badge @(usuario.Habilitado ? "bg-success" : "bg-danger")">
                                                            @(usuario.Habilitado ? "Activo" : "Inactivo")
                                                        </span>
                                                    </td>
                                                    <td>@usuario.FechaAlta.ToString("dd/MM/yyyy")</td>
                                                    <td class="text-end">
                                                        <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => OpenEditModal(usuario)">
                                                            <i class="fas fa-edit"></i> Editar
                                                        </button>
                                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(usuario)">
                                                            <i class="fas fa-trash"></i> Eliminar
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="8" class="text-center">
                                                    @(string.IsNullOrEmpty(searchText) ? "No hay usuarios disponibles" : "No se encontraron usuarios que coincidan con la búsqueda")
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="alert alert-info">
                            <h5><i class="fas fa-info-circle"></i> Acceso Restringido</h5>
                            <p>Solo los administradores pueden ver y gestionar usuarios.</p>
                            <p>Puedes cambiar tu contraseña usando el botón en la parte superior de esta página.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="container-fluid mt-5">
            <div class="alert alert-warning">
                <h4 class="alert-heading">Acceso Denegado</h4>
                <p>Debes iniciar sesión para acceder a esta página.</p>
                <hr>
                <a href="/" class="btn btn-primary">Ir a Inicio</a>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

<UsuarioModal @ref="usuarioModal" OnUsuarioChanged="LoadUsuarios" />
<CambiarContraseniaModal @ref="cambiarContraseniaModal" OnContraseniaChanged="HandleContraseniaChanged" />

@code {
    private List<UsuarioDTO>? usuarios;
    private bool loading = true;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private string searchText = string.Empty;
    private bool isAdmin = false;
    private int currentUserId = 0;

    private UsuarioModal? usuarioModal;
    private CambiarContraseniaModal? cambiarContraseniaModal;

    protected override async Task OnInitializedAsync()
    {
        isAdmin = await RoleHelper.IsAdminAsync();

        if (isAdmin)
        {
            await LoadUsuarios();
        }
        else
        {
            loading = false;
            // Obtener el ID del usuario actual para el cambio de contraseña
            var username = await AuthService.GetUsernameAsync();
            if (!string.IsNullOrEmpty(username))
            {
                try
                {
                    var allUsuarios = await UsuarioAPIClient.GetAllAsync();
                    var currentUser = allUsuarios.FirstOrDefault(u => u.NombreUsuario == username);
                    if (currentUser != null)
                    {
                        currentUserId = currentUser.Id;
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error al obtener usuario actual: {ex.Message}");
                }
            }
        }
    }

    private async Task LoadUsuarios()
    {
        try
        {
            loading = true;
            errorMessage = string.Empty;

            if (string.IsNullOrWhiteSpace(searchText))
            {
                usuarios = (await UsuarioAPIClient.GetAllAsync())?.ToList();
            }
            else
            {
                usuarios = (await UsuarioAPIClient.GetByCriteriaAsync(searchText))?.ToList();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar usuarios: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task SearchUsuarios()
    {
        await LoadUsuarios();
    }

    private async Task HandleSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchUsuarios();
        }
    }

    private async Task OpenAddModal()
    {
        if (!isAdmin)
        {
            errorMessage = "No tienes permisos para realizar esta acción.";
            return;
        }

        if (usuarioModal != null)
        {
            await usuarioModal.ShowAddModal();
        }
    }

    private async Task OpenEditModal(UsuarioDTO usuario)
    {
        if (!isAdmin)
        {
            errorMessage = "No tienes permisos para realizar esta acción.";
            return;
        }

        if (usuarioModal != null)
        {
            await usuarioModal.ShowEditModal(usuario);
        }
    }

    private async Task OpenChangePasswordModal()
    {
        if (currentUserId == 0)
        {
            errorMessage = "No se pudo obtener la información del usuario actual.";
            return;
        }

        if (cambiarContraseniaModal != null)
        {
            await cambiarContraseniaModal.ShowModal(currentUserId);
        }
    }

    private async Task ConfirmDelete(UsuarioDTO usuario)
    {
        if (!isAdmin)
        {
            errorMessage = "No tienes permisos para realizar esta acción.";
            return;
        }

        var confirm = await JSRuntime.InvokeAsync<bool>("confirm",
            $"¿Está seguro que desea eliminar el usuario '{usuario.NombreUsuario}'?");

        if (confirm)
        {
            await DeleteUsuario(usuario.Id);
        }
    }

    private async Task DeleteUsuario(int id)
    {
        try
        {
            await UsuarioAPIClient.DeleteAsync(id);
            successMessage = "Usuario eliminado exitosamente.";
            await LoadUsuarios();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al eliminar usuario: {ex.Message}";
        }
    }

    private void HandleContraseniaChanged()
    {
        successMessage = "Contraseña cambiada exitosamente.";
        StateHasChanged();
    }

    private string GetRoleDisplayName(int rol)
    {
        return rol switch
        {
            1 => "Administrador",
            2 => "Docente",
            3 => "Alumno",
            _ => "Desconocido"
        };
    }

    private string GetRoleBadgeClass(int rol)
    {
        return rol switch
        {
            1 => "bg-danger",
            2 => "bg-primary",
            3 => "bg-success",
            _ => "bg-secondary"
        };
    }
}
