@page "/usuarios"
@using DTOs
@using APIClients
@using BlazorServer.Components
@using Microsoft.AspNetCore.Components.Authorization
@inject IJSRuntime JSRuntime
@inject BlazorServer.Helpers.RoleHelper RoleHelper
@inject BlazorServer.Services.AuthClientService AuthService

<PageTitle>Usuarios</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h3>Gestión de Usuarios</h3>
                    </div>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @errorMessage
                            <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(successMessage))
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @successMessage
                            <button type="button" class="btn-close" @onclick="() => successMessage = string.Empty"></button>
                        </div>
                    }

                    @if (isAdmin)
                    {
                        <div class="card mb-3">
                            <div class="card-body">
                                <div class="row g-2">
                                    <div class="col-md-8">
                                        <input type="text"
                                               class="form-control"
                                               placeholder="Buscar por nombre de usuario, nombre, apellido o legajo..."
                                               @bind="searchText"
                                               @bind:event="oninput"
                                               @onkeyup="HandleSearchKeyUp" />
                                    </div>
                                    <div class="col-md-2">
                                        <button class="btn btn-outline-success w-100" @onclick="SearchUsuarios">
                                            <i class="fas fa-search"></i> Buscar
                                        </button>
                                    </div>
                                    <div class="col-md-2">
                                        <button class="btn btn-outline-primary w-100" @onclick="OpenAddModal">
                                            <i class="fas fa-plus"></i> Agregar
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @if (loading)
                        {
                            <div class="d-flex justify-content-center">
                                <div class="spinner-border" role="status">
                                    <span class="visually-hidden">Cargando...</span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-striped table-hover">
                                    <thead class="gradient-bg">
                                        <tr>
                                            <th>ID</th>
                                            <th>Usuario</th>
                                            <th>Persona</th>
                                            <th>Legajo</th>
                                            <th>Rol</th>
                                            <th>Estado</th>
                                            <th>Fecha Alta</th>
                                            <th class="text-end">Acciones</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (usuarios != null && usuarios.Any())
                                        {
                                            @foreach (var usuario in usuarios)
                                            {
                                                <tr>
                                                    <td>@usuario.Id</td>
                                                    <td>@usuario.NombreUsuario</td>
                                                    <td>@(string.IsNullOrEmpty(usuario.NombreCompletoPersona) ? "-" : usuario.NombreCompletoPersona)</td>
                                                    <td>@(usuario.Legajo?.ToString() ?? "-")</td>
                                                    <td>
                                                        <span class="badge @GetRoleBadgeClass(usuario.Rol)">
                                                            @GetRoleDisplayName(usuario.Rol)
                                                        </span>
                                                    </td>
                                                    <td>
                                                        <span class="badge @(usuario.Habilitado ? "bg-success" : "bg-danger")">
                                                            @(usuario.Habilitado ? "Activo" : "Inactivo")
                                                        </span>
                                                    </td>
                                                    <td>@usuario.FechaAlta.ToString("dd/MM/yyyy")</td>
                                                    <td class="text-end">
                                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenEditModal(usuario)">
                                                            <i class="fas fa-edit"></i> Editar
                                                        </button>
                                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(usuario)">
                                                            <i class="fas fa-trash"></i> Eliminar
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="8" class="text-center">
                                                    @(string.IsNullOrEmpty(searchText) ? "No hay usuarios disponibles" : "No se encontraron usuarios que coincidan con la búsqueda")
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="row justify-content-center">
                            <div class="col-md-8">
                                <div class="card shadow-sm">
                                    <div class="card-header gradient-bg text-white">
                                        <h5 class="card-title mb-0">
                                            <i class="fas fa-user me-2"></i>Mi Información de Usuario
                                        </h5>
                                    </div>
                                    <div class="card-body">
                                        @if (currentUserInfo != null)
                                        {
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="mb-3">
                                                        <label class="form-label fw-semibold">Nombre de Usuario</label>
                                                        <p class="form-control-plaintext">@currentUserInfo.NombreUsuario</p>
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="mb-3">
                                                        <label class="form-label fw-semibold">Rol</label>
                                                        <p>
                                                            <span class="badge @GetRoleBadgeClass(currentUserInfo.Rol)">
                                                                @GetRoleDisplayName(currentUserInfo.Rol)
                                                            </span>
                                                        </p>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="mb-3">
                                                        <label class="form-label fw-semibold">Estado</label>
                                                        <p>
                                                            <span class="badge @(currentUserInfo.Habilitado ? "bg-success" : "bg-danger")">
                                                                @(currentUserInfo.Habilitado ? "Activo" : "Inactivo")
                                                            </span>
                                                        </p>
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="mb-3">
                                                        <label class="form-label fw-semibold">Fecha de Alta</label>
                                                        <p class="form-control-plaintext">@currentUserInfo.FechaAlta.ToString("dd/MM/yyyy")</p>
                                                    </div>
                                                </div>
                                            </div>

                                            @if (!string.IsNullOrEmpty(currentUserInfo.NombreCompletoPersona))
                                            {
                                                <div class="row">
                                                    <div class="col-12">
                                                        <div class="mb-3">
                                                            <label class="form-label fw-semibold">Persona Asociada</label>
                                                            <p class="form-control-plaintext">@currentUserInfo.NombreCompletoPersona</p>
                                                        </div>
                                                    </div>
                                                </div>
                                            }

                                            @if (currentUserInfo.Legajo.HasValue)
                                            {
                                                <div class="row">
                                                    <div class="col-12">
                                                        <div class="mb-3">
                                                            <label class="form-label fw-semibold">Legajo</label>
                                                            <p class="form-control-plaintext">@currentUserInfo.Legajo</p>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <div class="alert alert-warning">
                                                <i class="fas fa-exclamation-triangle me-2"></i>
                                                No se pudo cargar la información de tu usuario.
                                            </div>
                                        }
                                    </div>
                                    <div class="card-footer bg-transparent">
                                        <div class="d-flex justify-content-end">
                                            <button class="btn btn-gradient btn-sm" @onclick="OpenChangePasswordModal">
                                                <i class="fas fa-key me-1"></i> Cambiar Contraseña
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="container-fluid mt-5">
            <div class="alert alert-warning">
                <h4 class="alert-heading">Acceso Denegado</h4>
                <p>Debes iniciar sesión para acceder a esta página.</p>
                <hr>
                <a href="/" class="btn btn-primary">Ir a Inicio</a>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

<UsuarioModal @ref="usuarioModal" OnUsuarioChanged="LoadUsuarios" />
<CambiarContraseniaModal @ref="cambiarContraseniaModal" OnContraseniaChanged="HandleContraseniaChanged" />

<style>
    .gradient-bg {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
        color: white !important;
        border-bottom: none !important;
    }

    .btn-gradient {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        color: white;
        font-weight: 600;
        transition: all 0.3s ease;
    }

        .btn-gradient:hover {
            background: linear-gradient(135deg, #764ba2 0%, #667eea 100%);
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(52, 152, 219, 0.3);
            color: white;
        }

        .btn-gradient:active {
            transform: translateY(0);
        }

    .form-control-plaintext {
        background: #f8f9fa;
        padding: 0.5rem 0.75rem;
        border-radius: 0.375rem;
        border: 1px solid #e9ecef;
    }
</style>

@code {
    private List<UsuarioDTO>? usuarios;
    private UsuarioDTO? currentUserInfo;
    private bool loading = true;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private string searchText = string.Empty;
    private bool isAdmin = false;
    private int currentUserId = 0;

    private UsuarioModal? usuarioModal;
    private CambiarContraseniaModal? cambiarContraseniaModal;

    protected override async Task OnInitializedAsync()
    {
        isAdmin = await RoleHelper.IsAdminAsync();

        if (isAdmin)
        {
            await LoadUsuarios();
        }
        else
        {
            await LoadCurrentUserInfo();
            loading = false;
            // Obtener el ID del usuario actual para el cambio de contraseña
            var username = await AuthService.GetUsernameAsync();
            if (!string.IsNullOrEmpty(username))
            {
                try
                {
                    var allUsuarios = await UsuarioAPIClient.GetAllAsync();
                    var currentUser = allUsuarios.FirstOrDefault(u => u.NombreUsuario == username);
                    if (currentUser != null)
                    {
                        currentUserId = currentUser.Id;
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error al obtener usuario actual: {ex.Message}");
                }
            }
        }
    }

    private async Task LoadUsuarios()
    {
        try
        {
            loading = true;
            errorMessage = string.Empty;

            if (string.IsNullOrWhiteSpace(searchText))
            {
                usuarios = (await UsuarioAPIClient.GetAllAsync())?.ToList();
            }
            else
            {
                usuarios = (await UsuarioAPIClient.GetByCriteriaAsync(searchText))?.ToList();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar usuarios: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task SearchUsuarios()
    {
        await LoadUsuarios();
    }

    private async Task HandleSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchUsuarios();
        }
    }

    private async Task OpenAddModal()
    {
        if (!isAdmin)
        {
            errorMessage = "No tienes permisos para realizar esta acción.";
            return;
        }

        if (usuarioModal != null)
        {
            await usuarioModal.ShowAddModal();
        }
    }

    private async Task OpenEditModal(UsuarioDTO usuario)
    {
        if (!isAdmin)
        {
            errorMessage = "No tienes permisos para realizar esta acción.";
            return;
        }

        if (usuarioModal != null)
        {
            await usuarioModal.ShowEditModal(usuario);
        }
    }

    private async Task OpenChangePasswordModal()
    {
        if (currentUserId == 0)
        {
            errorMessage = "No se pudo obtener la información del usuario actual.";
            return;
        }

        if (cambiarContraseniaModal != null)
        {
            await cambiarContraseniaModal.ShowModal(currentUserId);
        }
    }

    private async Task ConfirmDelete(UsuarioDTO usuario)
    {
        if (!isAdmin)
        {
            errorMessage = "No tienes permisos para realizar esta acción.";
            return;
        }

        var confirm = await JSRuntime.InvokeAsync<bool>("confirm",
            $"¿Está seguro que desea eliminar el usuario '{usuario.NombreUsuario}'?");

        if (confirm)
        {
            await DeleteUsuario(usuario.Id);
        }
    }

    private async Task DeleteUsuario(int id)
    {
        try
        {
            await UsuarioAPIClient.DeleteAsync(id);
            successMessage = "Usuario eliminado exitosamente.";
            await LoadUsuarios();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al eliminar usuario: {ex.Message}";
        }
    }

    private async Task LoadCurrentUserInfo()
    {
        try
        {
            var username = await AuthService.GetUsernameAsync();
            if (!string.IsNullOrEmpty(username))
            {
                var allUsuarios = await UsuarioAPIClient.GetAllAsync();
                currentUserInfo = allUsuarios.FirstOrDefault(u => u.NombreUsuario == username);

                if (currentUserInfo != null)
                {
                    currentUserId = currentUserInfo.Id;
                }
                else
                {
                    errorMessage = "No se pudo encontrar la información de tu usuario.";
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar información del usuario: {ex.Message}";
            Console.WriteLine($"Error al obtener usuario actual: {ex.Message}");
        }
    }

    private void HandleContraseniaChanged()
    {
        successMessage = "Contraseña cambiada exitosamente.";
        StateHasChanged();
    }

    private string GetRoleDisplayName(int rol)
    {
        return rol switch
        {
            1 => "Administrador",
            2 => "Docente",
            3 => "Alumno",
            _ => "Desconocido"
        };
    }

    private string GetRoleBadgeClass(int rol)
    {
        return rol switch
        {
            1 => "bg-danger",
            2 => "bg-primary",
            3 => "bg-success",
            _ => "bg-secondary"
        };
    }
}
