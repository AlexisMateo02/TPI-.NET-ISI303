@page "/logout"
@inject BlazorServer.Services.AuthClientService AuthService
@inject NavigationManager Navigation

<PageTitle>Cerrando sesión...</PageTitle>

<div class="logout-container text-center" style="padding: 50px;">
    <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
        <span class="visually-hidden">Cerrando sesión...</span>
    </div>
    <p class="mt-3">Cerrando sesión...</p>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await AuthService.LogoutAsync();
        // Redirigir a la página principal (que mostrará el login)
        Navigation.NavigateTo("/", true);
    }
}
