@page "/planes"
@using DTOs
@using APIClients
@using BlazorServer.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime
@inject BlazorServer.Helpers.RoleHelper RoleHelper

<PageTitle>Planes</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <h3>Planes</h3>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @errorMessage
                            <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(successMessage))
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @successMessage
                            <button type="button" class="btn-close" @onclick="() => successMessage = string.Empty"></button>
                        </div>
                    }

                    @if (isAdmin)
                    {
                        <div class="mb-3">
                            <button class="btn btn-outline-primary" @onclick="OpenAddModal">
                                <i class="fas fa-plus"></i> Agregar
                            </button>
                        </div>
                    }

                    @if (loading)
                    {
                        <div class="d-flex justify-content-center">
                            <div class="spinner-border" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="gradient-bg">
                                    <tr>
                                        <th>Id</th>
                                        <th>Descripción</th>
                                        <th>Especialidad</th>
                                        <th class="text-end">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (planes != null && planes.Any())
                                    {
                                        @foreach (var plan in planes)
                                        {
                                            <tr>
                                                <td>@plan.IdPlan</td>
                                                <td>@plan.Descripcion</td>
                                                <td>@plan.DescripcionEspecialidad</td>
                                                <td class="text-end">
                                                    <button class="btn btn-sm btn-outline-info me-1"
                                                            @onclick="() => GenerarPdf(plan.IdPlan)"
                                                            title="Generar Reporte"
                                                            disabled="@generatingPdf">
                                                        @if (generatingPdf && pdfPlanId == plan.IdPlan)
                                                        {
                                                            <span class="spinner-border spinner-border-sm"></span>
                                                        }
                                                        else
                                                        {
                                                            <i class="fas fa-file-pdf"></i>
                                                            <span class="ms-1">Generar Reporte</span>
                                                        }
                                                    </button>
                                                    @if (isAdmin)
                                                    {
                                                        <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => OpenEditModal(plan)">
                                                            <i class="fas fa-edit"></i> Editar
                                                        </button>
                                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(plan)">
                                                            <i class="fas fa-trash"></i> Eliminar
                                                        </button>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="4" class="text-center">
                                                No hay planes disponibles
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="container-fluid mt-5">
            <div class="alert alert-warning">
                <h4 class="alert-heading">Acceso Denegado</h4>
                <p>Debes iniciar sesión para acceder a esta página.</p>
                <hr>
                <a href="/" class="btn btn-primary">Ir a Inicio</a>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

<PlanModal @ref="planModal" OnPlanChanged="LoadPlanes" IsReadOnly="@(!isAdmin)" />

<style>
    .gradient-bg {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
        color: white !important;
        border-bottom: none !important;
    }
</style>

@code {
    private List<PlanDTO>? planes;
    private bool loading = true;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private PlanModal? planModal;
    private bool isAdmin = false;
    private bool generatingPdf = false;
    private int pdfPlanId = 0;

    protected override async Task OnInitializedAsync()
    {
        isAdmin = await RoleHelper.IsAdminAsync();
        await LoadPlanes();
    }

    private async Task LoadPlanes()
    {
        try
        {
            loading = true;
            planes = (await PlanAPIClient.GetAllAsync())?.ToList();
            successMessage = string.Empty;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar planes: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task GenerarPdf(int idPlan)
    {
        try
        {
            generatingPdf = true;
            pdfPlanId = idPlan;
            errorMessage = string.Empty;
            StateHasChanged();

            byte[] pdfBytes = await PlanAPIClient.GenerarPdfAsync(idPlan);

            var plan = planes?.FirstOrDefault(p => p.IdPlan == idPlan);
            string fileName = plan != null
                ? $"Plan_{plan.Descripcion.Replace(" ", "_")}.pdf"
                : $"Plan_{idPlan}.pdf";

            await JSRuntime.InvokeVoidAsync("downloadFile", fileName, Convert.ToBase64String(pdfBytes));

            successMessage = "PDF generado exitosamente.";
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al generar PDF: {ex.Message}";
        }
        finally
        {
            generatingPdf = false;
            pdfPlanId = 0;
            StateHasChanged();
        }
    }

    private async Task OpenAddModal()
    {
        if (!isAdmin)
        {
            errorMessage = "No tienes permisos para realizar esta acción.";
            return;
        }

        if (planModal != null)
        {
            await planModal.ShowAddModal();
        }
    }

    private async Task OpenEditModal(PlanDTO plan)
    {
        if (!isAdmin)
        {
            errorMessage = "No tienes permisos para realizar esta acción.";
            return;
        }

        if (planModal != null)
        {
            await planModal.ShowEditModal(plan);
        }
    }

    private async Task ConfirmDelete(PlanDTO plan)
    {
        if (!isAdmin)
        {
            errorMessage = "No tienes permisos para realizar esta acción.";
            return;
        }

        var confirm = await JSRuntime.InvokeAsync<bool>("confirm",
            $"¿Está seguro que desea eliminar el plan '{plan.Descripcion}'?");

        if (confirm)
        {
            await DeletePlan(plan.IdPlan);
        }
    }

    private async Task DeletePlan(int id)
    {
        try
        {
            await PlanAPIClient.DeleteAsync(id);
            successMessage = "Plan eliminado exitosamente.";
            await LoadPlanes();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al eliminar plan: {ex.Message}";
        }
    }
}