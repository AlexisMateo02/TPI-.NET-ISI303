@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization

<CascadingAuthenticationState>
    <AuthorizeView>
        <Authorized Context="authContext">
            @* Layout completo con menú para usuarios autenticados *@
            <div class="page">
                <div class="sidebar">
                    <NavMenu />
                </div>

                <main>
                    <div class="top-row px-4 auth">
                        <span class="me-3">Hola, @authContext.User.Identity?.Name!</span>
                        <a href="logout" class="btn btn-sm btn-outline-danger">Cerrar Sesión</a>
                    </div>

                    <article class="content px-4">
                        @Body
                    </article>
                </main>
            </div>
        </Authorized>
        <NotAuthorized Context="notAuthContext">
            @* Solo el contenido sin menú para usuarios no autenticados *@
            <div class="public-layout">
                @Body
            </div>
        </NotAuthorized>
    </AuthorizeView>
</CascadingAuthenticationState>

<style>
    .public-layout {
        min-height: 100vh;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }

    .page {
        display: flex;
        flex-direction: column;
        height: 100vh;
    }

    .sidebar {
        background-color: #f7f7f7;
        border-right: 1px solid #d6d5d5;
    }

    .top-row {
        background-color: #f7f7f7;
        border-bottom: 1px solid #d6d5d5;
        justify-content: flex-end;
        height: 3.5rem;
        display: flex;
        align-items: center;
    }

    .content {
        flex: 1;
        padding: 1rem;
    }

    @@media (min-width: 641px) {
        .page {
            flex-direction: row;
        }

        .sidebar {
            width: 250px;
            height: 100vh;
            position: sticky;
            top: 0;
        }

        .top-row {
            position: sticky;
            top: 0;
            z-index: 1;
        }
    }
</style>